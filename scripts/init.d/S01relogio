#!/bin/sh
# Giochi Konsol OS v1.2 — S01relogio: acerta o relogio no boot.
#
# POR QUE ISTO EXISTE (medido, nao suposto)
# -----------------------------------------
# O aparelho NAO tem relogio de hardware: `grep -ci rtc` no dmesg completo do
# boot da X55 devolve ZERO, e nao ha' `/dev/rtc0`. O RK817 tem RTC, mas sem
# bateria de backup e sem `CONFIG_RTC_DRV_RK808` no linux.fragment ele nunca
# aparece. Consequencia medida, comparando console e PC:
#
#     console: Sat Aug  5 09:03:57 UTC 2017   (epoch 1501923837)
#     PC:      dom 01 nov 2026 15:10          (epoch 1793556647)
#
# O relogio do console fica NO PASSADO — e isso nao e' cosmetico:
#
#   * `grow-user.sh` roda antes deste script (inittab, antes do `mount -a`) e
#     por isso usa `resize2fs -f`; com o relogio atras, `s_lastcheck` fica
#     menor que o `s_mtime` gravado pelo PC e o resize2fs recusaria para sempre;
#   * certificado TLS de servidor (a Loja baixa por https) aparece como
#     "ainda nao valido" — o handshake falha sem mensagem util;
#   * todo log sai com data de 2017, e comparar dois logs deixa de fazer
#     sentido;
#   * `known_hosts` e a validade da chave do dropbear ficam no passado.
#
# O QUE FAZ
# ---------
# Grava `date +%s` num arquivo da particao de dados no desligamento (rcK) e
# restaura no boot seguinte. E' o mesmo principio do `fake-hwclock` do Debian.
# Sem RTC nao existe fonte de verdade entre um boot e outro; o melhor
# disponivel e' "a hora do ultimo desligamento", que erra no maximo o tempo em
# que o aparelho ficou desligado — aceitavel, e MUITO melhor que 9 anos atras.
#
# LIMITE HONESTO: no PRIMEIRO boot depois de gravar o cartao nao ha' arquivo
# salvo, entao o relogio continua errado ate' o primeiro desligamento. E' o
# preco de nao ter RTC; se algum dia a placa ganhar um, este script passa a
# ler `hwclock -s` e o arquivo vira so' fallback.
#
# Nunca aborta o boot: sem /user gravavel apenas registra e segue.

if [ -r /etc/giochi/lib.sh ]; then
    . /etc/giochi/lib.sh
fi

# Duas saidas de proposito: o syslog (que o S00bootlog grava no cartao) e o
# stderr (que o rcS duplica com `tee`). Usar `logger -s ... 2>/dev/null`
# parecia razoavel e apagava a mensagem: o `-s` do BusyBox escreve em STDERR,
# exatamente o descritor que o `2>/dev/null` descartava. As mensagens deste
# script nao apareciam em lugar nenhum — so' o efeito, sem o motivo.
log() {
    logger -t relogio -- "$*" 2>/dev/null || true
    echo "relogio: $*" >&2
}

# A particao de dados e' a unica gravavel e persiste entre boots. Se ela nao
# estiver montada, nao ha' onde guardar/ler: sai sem mexer no relogio.
ARQUIVO=""
for base in /user /user2; do
    if mountpoint -q "$base" 2>/dev/null; then
        ARQUIVO="$base/.giochi/relogio"
        break
    fi
done

if [ -z "$ARQUIVO" ]; then
    log "particao de dados fora do ar; relogio fica como esta'"
    exit 0
fi

if [ ! -d "${ARQUIVO%/*}" ]; then
    mkdir -p "${ARQUIVO%/*}" 2>/dev/null || {
        log "nao consegui criar ${ARQUIVO%/*}"
        exit 0
    }
fi

# ---- pedido do usuario (via MTP) ------------------------------------------
# docs/RELÓGIO.md: o MTP expoe /user ao PC, entao o usuario pode criar um
# arquivo de texto com a data e o sistema a aplica no proximo boot. Por que
# isto existe: o aparelho nao tem RTC e a bateria do RTC, quando trocada,
# derruba a fonte de hora (a epoca do ultimo desligamento fica velha). Sem
# rede ha' um unico caminho para corrigir: o usuario ditar a data — e o MTP
# e' o que existe sem cabear o aparelho.
#
# Formato aceito (um por linha, o primeiro que casar):
#   so' digitos          -> epoca (ex.: 1793556647)
#   qualquer outra coisa -> data legivel para `date -s` (ex.: 2026-11-01 15:30)
#
# Aplicou -> grava na fonte persistente E remove o pedido (senao reaplicaria
# em todo boot). Invalido -> mantem o arquivo e registra: o aviso a cada boot
# e' proposital, lembra que existe um pedido pendente para corrigir.
PEDIDO="${ARQUIVO}.pedido"
if [ -f "$PEDIDO" ]; then
    _texto=$(sed -n '1p' "$PEDIDO" 2>/dev/null | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    _aplicado=0
    if [ -n "$_texto" ]; then
        case "$_texto" in
            ''|*[!0-9]*)
                # Data legivel: `date -s` do BusyBox aceita "YYYY-MM-DD
                # hh:mm[:ss]". Como argumento UNICO entre aspas: nada de eval,
                # nada de shell — o texto nao e' interpretado.
                if date -s "$_texto" >/dev/null 2>&1; then
                    _ano=$(date -u +%Y 2>/dev/null | tr -dc '0-9')
                    if [ "$_ano" -ge 2020 ] 2>/dev/null && \
                       [ "$_ano" -le 2099 ] 2>/dev/null; then
                        _aplicado=1
                    else
                        log "pedido de data aplicado mas ficou no ano $_ano; rejeitado"
                        # devolve o relogio ao estado anterior: sem RTC o
                        # melhor que temos e' a epoca salva, lida logo abaixo.
                        if [ -r "$ARQUIVO" ]; then
                            _antigo=$(tr -dc '0-9' < "$ARQUIVO" 2>/dev/null)
                            case "$_antigo" in ''|*[!0-9]*) ;; *)
                                date -s "@$_antigo" >/dev/null 2>&1 || true ;;
                            esac
                        fi
                    fi
                else
                    log "pedido de data invalido ('$_texto'); ignorado"
                fi
                ;;
            *)
                # Epoca: a mesma faixa de sanidade do resto do script.
                if [ "$_texto" -gt 1577836800 ] && \
                   [ "$_texto" -lt 4102444800 ]; then
                    if date -s "@$_texto" >/dev/null 2>&1; then
                        _aplicado=1
                    else
                        log "date -s falhou para o pedido @$_texto"
                    fi
                else
                    log "pedido de data fora de faixa ($_texto); ignorado"
                fi
                ;;
        esac
    fi
    if [ "$_aplicado" = 1 ]; then
        printf '%s\n' "$(date +%s 2>/dev/null | tr -dc '0-9')" \
            > "$ARQUIVO" 2>/dev/null || true
        rm -f "$PEDIDO" 2>/dev/null || true
        log "pedido de data aplicado ($(date -u '+%Y-%m-%d %H:%M:%S UTC')); fonte persistente atualizada"
    fi
fi

# ---- restaura -------------------------------------------------------------
# O arquivo tem de conter UM inteiro (epoch). Qualquer outra coisa e' lixo de
# desligamento bruto: ignorar em vez de setar uma data absurda.
if [ -r "$ARQUIVO" ]; then
    salvo=$(cat "$ARQUIVO" 2>/dev/null | tr -dc '0-9')
    case "$salvo" in
        ''|*[!0-9]*)
            log "arquivo de relogio invalido; ignorando"
            ;;
        *)
            # Sanidade: recusa epoca absurda (antes de 2020 ou depois de 2100).
            # Um cartao com lixo no arquivo nao pode jogar o relogio para 1970.
            if [ "$salvo" -gt 1577836800 ] && [ "$salvo" -lt 4102444800 ]; then
                if date -s "@$salvo" >/dev/null 2>&1; then
                    log "relogio restaurado: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
                else
                    log "date -s falhou; relogio fica como esta'"
                fi
            else
                log "relogio salvo fora de faixa ($salvo); ignorando"
            fi
            ;;
    esac
else
    # ---- ultimo recurso: a data que o PC deixou no cartao ---------------
    # No PRIMEIRO boot depois de gravar o cartao nao ha' epoca salva, e /user
    # nasce VAZIO (o post-image.sh cria user.ext4 vazio) — nao existe arquivo
    # nenhum ali de onde tirar a hora. Mas a particao de boot (p1, FAT) foi
    # escrita pelo PC quando a imagem foi gerada: o mtime mais NOVO dali e'
    # uma data real, nunca futura, e infinitamente melhor que 2017.
    #
    # Sem isto o conserto nao se sustentava: o rcK recusa salvar 2017 (fora de
    # faixa) e o relogio ficaria errado PARA SEMPRE, porque nunca haveria uma
    # epoca plausivel para restaurar.
    #
    # Por que o MAIOR mtime e nao o do arquivo principal: os arquivos criados
    # no proprio aparelho carregam 2017. O mais novo do conjunto e' sempre o
    # que veio do PC.
    # GIOCHI_RELOGIO_BOOT_DEV / _MNT existem SO' para teste: o host nao tem
    # root para criar loop device, e o tests/test_relogio.py precisa exercitar
    # este caminho. Mesma ideia do GIOCHI_ROOT_DEV do grow-user.sh.
    _bp=${GIOCHI_RELOGIO_BOOT_DEV:-}
    if [ -z "$_bp" ] && command -v giochi_boot_part >/dev/null 2>&1; then
        _bp=$(giochi_boot_part)
    fi
    _tmp=${GIOCHI_RELOGIO_BOOT_MNT:-/run/relogio-boot}
    _melhor=0
    if [ -n "$_bp" ] && { [ -b "$_bp" ] || [ -n "${GIOCHI_RELOGIO_BOOT_DEV:-}" ]; }; then
        mkdir -p "$_tmp" 2>/dev/null || true
        if mount -t vfat -o ro,noatime "$_bp" "$_tmp" 2>/dev/null; then
            for _f in "$_tmp"/* "$_tmp"/dtbs/* "$_tmp"/extlinux/*; do
                [ -f "$_f" ] || continue
                _e=$(date -r "$_f" +%s 2>/dev/null) || continue
                case "$_e" in ''|*[!0-9]*) continue ;; esac
                [ "$_e" -gt "$_melhor" ] && _melhor=$_e
            done
            umount "$_tmp" 2>/dev/null || true
        fi
    fi
    if [ "$_melhor" -gt 1577836800 ] && [ "$_melhor" -lt 4102444800 ]; then
        if date -s "@$_melhor" >/dev/null 2>&1; then
            log "sem relogio salvo; usei a data do cartao ($_bp): $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
        fi
    else
        log "sem relogio salvo e sem data utilizavel no cartao: $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
    fi
fi

exit 0
