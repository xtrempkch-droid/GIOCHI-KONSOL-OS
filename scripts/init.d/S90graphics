#!/bin/sh
# Giochi Konsol OS v1.2 — S90graphics (ADR-04/05, S8).
# Sobe Gamescope com backend DRM puro e executa o Launcher.
#
# POR QUE S90 E NAO S20 (AGENTS.md 3.86): este script termina em `exec`, que
# SUBSTITUI o processo. Dentro do laco do rcS, isso mata o resto da sequencia —
# e foi exatamente o que aconteceu no boot real da X55: chamado de S20, ele
# executava antes de S30swap, S40dongle, S50usb, S55usbnet, S60mtpd e S62sshd.
# Resultado: gadget USB nunca configurado, nenhuma interface de rede, MTP e SSH
# mortos — e nada no log, porque os scripts simplesmente nao rodavam.
# O supervisor tem de ser o ULTIMO: por isso o prefixo S90.
set -u

# lib.sh: helpers comuns (GIOCHI_RUN_DIR, log de boot). O '.' que falha ABORTA
# shell nao-interativo, entao a leitura e testada com 'if' (AGENTS.md 3.5).
if [ -r /etc/giochi/lib.sh ]; then
    . /etc/giochi/lib.sh
fi

TAG=S90graphics
# A identidade vem de /etc/giochi/device.conf, NAO do /proc/device-tree.
# O compatible do RK3566 comeca por "powkiddy" (fabricante), entao ler o
# primeiro campo dava 'SoC powkiddy nao reconhecido' e o Mesa ficava sem
# override — medido no boot #3 da X55. O device-tree so e' fallback, e o
# -DGIOCHI_SOC compilado e' o ultimo recurso.
DEVICE_CONF=/etc/giochi/device.conf
SOC=""
if [ -r "$DEVICE_CONF" ]; then
    SOC=$(sed -n 's/^GIOCHI_SOC=//p' "$DEVICE_CONF" | head -n1)
fi
if [ -z "${SOC:-}" ]; then
    SOC=$(tr -d '\0' </proc/device-tree/compatible 2>/dev/null | tr ',' '\n' \
          | grep -m1 '^rk[0-9]' || true)
fi
[ -n "${SOC:-}" ] || SOC=${GIOCHI_SOC:-rk3326}

log() { logger -t "$TAG" -- "$*" 2>/dev/null || echo "$TAG: $*" >&2; }

# Painel/rotacao do aparelho (gerado por post-build.sh).
PANEL=640x480
ROTATION=0
if [ -f "$DEVICE_CONF" ]; then
    panel=$(sed -n 's/^GIOCHI_PANEL=//p' "$DEVICE_CONF" | head -n1)
    rotation=$(sed -n 's/^GIOCHI_ROTATION=//p' "$DEVICE_CONF" | head -n1)
    [ -n "${panel:-}" ] && PANEL=$panel
    [ -n "${rotation:-}" ] && ROTATION=$rotation
fi

# Sentido da rotacao: o device.conf diz o que o DTB declara (270 na X55), mas
# 90 x 270 produzem os dois paisagem — o que difere e' a imagem sair de cabeca
# para baixo. Isso SO' o aparelho decide, e exigir recompilar por causa disso
# custa 40 min por tentativa. Entao: `echo 90 > /boot/rotate` na particao 1
# (mesmo padrao do nolog/nosplash) sobrepoe o valor do device.conf.
if [ -r /boot/rotate ]; then
    _r=$(tr -cd '0-9' < /boot/rotate 2>/dev/null)
    case "$_r" in
        0|90|180|270)
            ROTATION=$_r
            log "rotacao: $_r (do cartao, /boot/rotate)"
            ;;
        "")
            ;;
        *)
            log "aviso: /boot/rotate com valor invalido '$_r'; ignorado"
            ;;
    esac
fi

# A resolucao logica inverte quando o painel esta em 90/270.
PANEL_W=${PANEL%x*}
PANEL_H=${PANEL#*x}
case "$ROTATION" in
    90|270)
        GIOCHI_WIDTH=${GIOCHI_WIDTH:-$PANEL_H}
        GIOCHI_HEIGHT=${GIOCHI_HEIGHT:-$PANEL_W}
        ;;
    *)
        GIOCHI_WIDTH=${GIOCHI_WIDTH:-$PANEL_W}
        GIOCHI_HEIGHT=${GIOCHI_HEIGHT:-$PANEL_H}
        ;;
esac
export GIOCHI_WIDTH GIOCHI_HEIGHT
# A rotacao e' do PAINEL, nao do layout: o Launcher desenha no tamanho logico
# (layout.json) e gira na apresentacao. Sem exportar isso o framebuffer da X55
# sai 720x1280 em retrato e a UI aparece em pe' (medido no aparelho).
export GIOCHI_ROTATION="$ROTATION"
log "painel=$PANEL rotacao=$ROTATION => ${GIOCHI_WIDTH}x${GIOCHI_HEIGHT}"

# --- escolha do driver do Mesa (AGENTS.md §3.68) ------------------------
# NAO force MESA_LOADER_DRIVER_OVERRIDE=panfrost. Nesta placa o dispositivo
# DRM e' o *display* (rockchip-drm), e quem conversa com ele e' o driver kmsro
# `rockchip_dri.so`, que delega a RENDERIZACAO ao panfrost. Forcar `panfrost`
# carrega o driver de render direto contra o no' do display; ele nao reconhece
# o dispositivo, o EGL falha e o SDL devolve apenas "EGL not initialized" —
# foi o que manteve a tela apagada mesmo com o DRM bindado (§3.48 fechado).
#
# Medido no binario da imagem: `strings rockchip_dri.so` contem "panfrost", que
# e' a tabela kmsro do Mesa. Sem override o Mesa faz rockchip -> panfrost
# sozinho, que e' o caminho certo.
#
# Se o hardware nao passar, cai para software (kms_swrast). Ele existe porque
# BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y: sem ele nao havia NENHUM caminho
# (nem panfrost nem swrast), e o EGL falhava sempre.
PROBE_TXT=/run/giochi/gpu-probe.txt
mkdir -p /run/giochi 2>/dev/null || true

aplicar_mesa() {
    if [ -n "${1:-}" ]; then
        export MESA_LOADER_DRIVER_OVERRIDE="$1"
    else
        unset MESA_LOADER_DRIVER_OVERRIDE 2>/dev/null || true
    fi
}

# Roda a sonda com o override pedido ("" = deixa o Mesa decidir pelo driver do
# DRM) e devolve 0 se os cinco passos passaram. A saida vai para o log do boot.
# Codigos de saida: 0 = passou, 1 = falhou, 2 = NAO FOI TESTADO.
# O 2 e' essencial: antes a funcao devolvia 0 quando a sonda nao existia, e o
# chamador logava "driver do barramento passou" sem ninguem ter testado nada.
sonda_video() {
    aplicar_mesa "${1:-}"
    [ "${GIOCHI_NO_GPU_PROBE:-0}" = "1" ] && return 2
    [ -x /usr/bin/giochi-gpu-probe ] || return 2
    # O redirecionamento tambem falha: sem /run/giochi o ">>" nao abre e o
    # comando nem roda — a sonda diria FALHOU sem ter tentado nada.
    mkdir -p "$(dirname "$PROBE_TXT")" 2>/dev/null || true
    printf '\n--- driver=%s ---\n' "${1:-(auto)}" >> "$PROBE_TXT" 2>/dev/null || \
        return 1
    giochi-gpu-probe >> "$PROBE_TXT" 2>&1
}

export GIOCHI_SOC="$SOC"

# Nao deve subir um segundo supervisor.
mkdir -p /run/giochi
: > /run/giochi/launcher.lock 2>/dev/null || true

# Sanidade (S8): modetest deve listar o conector ativo em 640x480@60.
if command -v modetest >/dev/null 2>&1; then
    modetest -c >/dev/null 2>&1 || log "aviso: modetest falhou"
fi

# Gamescope canonico (backend DRM puro, sem XWayland, sem shell):
#   gamescope --backend drm --fullscreen --embedded \
#             -W 640 -H 480 -r 60 -- /usr/bin/giochi-init
# Fallback documentado (S8): sem DRM puro, rodar o Launcher direto no KMS
# (backend headless) enquanto o suporte a DRM estabiliza.
# O boot chegou ao supervisor: retira o marcador de "boot em andamento" para
# o proximo boot nao reportar uma falha falsa (S00bootlog / docs/BOOT-DEBUG.md).
giochi_boot_marker_clear 2>/dev/null || true

# --- entrega o framebuffer para a UI (AGENTS.md §3.59) ------------------
# O kernel DESTA imagem tem fbcon, ao contrario do que o linux.fragment
# pretendia: CONFIG_FB=n e' sobrescrito por CONFIG_DRM_FBDEV_EMULATION=y, que
# faz "select FB" e liga FRAMEBUFFER_CONSOLE. Medido no .config do build:
#   # CONFIG_FB is not set          <- o fragmento
#   CONFIG_DRM_FBDEV_EMULATION=y
#   CONFIG_FRAMEBUFFER_CONSOLE=y   <- o que vale
# E' o console que aparece na tela do aparelho antes do Launcher.
#
# Dois efeitos atrapalham o SDL/KMSDRM e precisam ser desligados aqui:
#   1. o cursor do vt PISCA e repinta a tela por cima do que o SDL desenhou;
#   2. qualquer printk novo (ex.: "rk817-charger: Battery voltage ... below
#      minimum" a cada 8 s) tambem pinta por cima.
# Desligar o console de video NAO perde informacao: o log continua no serial
# (ttyS2) e na particao FAT do cartao (S00bootlog).
# GIOCHI_KEEP_FBCON=1 mantem o console (para depurar com a tela).
devolver_framebuffer() {
    [ "${GIOCHI_KEEP_FBCON:-0}" = "1" ] && {
        log "GIOCHI_KEEP_FBCON=1: console de video mantido"
        return 0
    }

    # 1.1: so panico/emergencia vao para o console de video. O log do cartao
    # e' alimentado pelo syslogd/klogd, nao por este nivel.
    echo "1 4 1 7" > /proc/sys/kernel/printk 2>/dev/null || \
        log "aviso: nao foi possivel baixar o console_loglevel"

    # Desvincula o fbcon do framebuffer (para o cursor e os printk de
    # pintarem). vtcon0 e' o dummy; o fbcon costuma ser vtcon1, mas o numero
    # varia com a config, entao procuramos pelo nome.
    desvinculados=0
    for v in /sys/class/vtconsole/vtcon*; do
        [ -r "$v/name" ] || continue
        case "$(cat "$v/name" 2>/dev/null)" in
            *frame?buffer*) ;;
            *) continue ;;
        esac
        if echo 0 > "$v/bind" 2>/dev/null; then
            desvinculados=$((desvinculados + 1))
        fi
    done

    if [ "$desvinculados" -gt 0 ]; then
        log "framebuffer entregue a UI ($desvinculados console(s) de video desvinculado(s))"
    else
        log "aviso: nenhum console de video para desvincular; a UI pode ser sobrescrita"
    fi
}
devolver_framebuffer

# A decisao do Mesa vem DEPOIS de entregar o framebuffer: com o fbcon
# vinculado o DRM tem outro dono e a sonda mediria uma situacao que o SDL nao
# vai encontrar.
: > "$PROBE_TXT" 2>/dev/null || true

if [ -n "${GIOCHI_MESA_OVERRIDE:-}" ]; then
    aplicar_mesa "$GIOCHI_MESA_OVERRIDE"
    log "Mesa: override manual '$GIOCHI_MESA_OVERRIDE' (GIOCHI_MESA_OVERRIDE)"
else
    sonda_video ""
    case $? in
        0)
            aplicar_mesa ""
            log "Mesa: driver do barramento (kmsro rockchip -> panfrost)"
            ;;
        2)
            # Nao testado (sonda ausente ou desligada): mantem o caminho
            # normal do Mesa e diz isso, em vez de afirmar que passou.
            aplicar_mesa ""
            log "Mesa: sonda nao executada; deixando o Mesa escolher"
            ;;
        *)
            if sonda_video kms_swrast; then
                aplicar_mesa kms_swrast
                log "Mesa: AVISO sem aceleracao; usando software (kms_swrast)"
            else
                aplicar_mesa ""
                log "Mesa: nenhum driver passou na sonda; veja $PROBE_TXT"
            fi
            ;;
    esac
fi


# --- relato da sonda de video -------------------------------------------
# A sonda ja' rodou no bloco do Mesa acima, no MESMO estado em que o SDL vai
# rodar (depois da entrega do framebuffer). Aqui so' copiamos o resultado para
# o log, linha por linha: o S00bootlog guarda isso na particao FAT, entao o
# proximo boot diz exatamente em qual dos cinco passos parou.
if [ -f "$PROBE_TXT" ] && [ -s "$PROBE_TXT" ]; then
    while IFS= read -r _linha; do
        [ -n "$_linha" ] || continue
        log "sonda: $_linha"
    done < "$PROBE_TXT"
fi

# --- splash: instrumento de diagnostico, nao enfeite --------------------
# O splash usa SO' SDL_CreateWindow + SDL_RenderCopy. Se ele aparece, o SDL
# abriu o KMSDRM e sabe desenhar — ou seja, o problema (se houver) esta na UI,
# nao no video. Se NAO aparece e o console volta com o log (render_open chama
# devolver_console_de_video), o SDL nem abriu.
#
# 600 quadros ~= 10 s: tempo de olhar para a tela e ver. O padrao compilado
# (180) e' curto demais para servir de teste num aparelho.
# Desligar:   `touch nosplash` na particao 1 do cartao (mesmo padrao do
#             `nolog` do bootlog) — nao exige recompilar.
# Ajustar:    GIOCHI_SPLASH_FRAMES=N no ambiente do rcS.
# Permanente: GIOCHI_SPLASH_ALWAYS=1 (fica na tela ate' um botao).
if [ -f /boot/nosplash ] || [ -f /user/nosplash ]; then
    export GIOCHI_SPLASH_FRAMES=0
    log "splash: desligado pelo marcador nosplash"
elif [ -n "${GIOCHI_SPLASH_FRAMES:-}" ]; then
    log "splash: $GIOCHI_SPLASH_FRAMES quadros (do ambiente)"
else
    export GIOCHI_SPLASH_FRAMES=600
    log "splash: 600 quadros (~10 s); use nosplash na particao 1 para desligar"
fi

if command -v gamescope >/dev/null 2>&1; then
    exec gamescope --backend drm --fullscreen --embedded \
         -W "${GIOCHI_WIDTH:-640}" -H "${GIOCHI_HEIGHT:-480}" \
         -r "${GIOCHI_REFRESH:-60}" -- /usr/bin/giochi-init
fi

log "gamescope ausente; executando giochi-init direto (fallback S8)"
# `exec`: daqui para baixo o supervisord E' o giochi-init. Isto so' pode
# acontecer no ultimo script do rcS (AGENTS.md 3.86).
exec /usr/bin/giochi-init
