#!/bin/sh
# Giochi Konsol OS v1.2 — S05modules: carrega os modulos do kernel no boot.
#
# POR QUE ESTE SCRIPT EXISTE (medido, nao suposto)
# ------------------------------------------------
# Neste sistema NAO ha udev. Cada driver que nao e' embutido (=y) precisa de
# alguem chamando modprobe. Sem isso, um boot da X55 mostrou
# `/lib/modules/6.12.0/` com 1268 .ko e **ZERO** carregado:
#
#   dw-mipi-dsi-rockchip fe060000.dsi: failed to get mipi dphy: -517
#   ALSA device list: No soundcards found.
#   (nenhum rtw88, nenhum hci_uart)
#
# O kernel pede modulo sozinho (request_module -> /sbin/modprobe), mas so
# DEPOIS que o rootfs existe — e os dispositivos de plataforma nascem por
# volta de 0,5 s, antes do rootfs (~1,2 s). Aqueles pedidos morrem com
# -ENOENT e nada os repete.
#
# A PRIMEIRA TENTATIVA ESTAVA ERRADA (medido, nao suposto)
# -------------------------------------------------------
# A versao anterior chamava `mdev -s` esperando que ele fizesse o coldplug.
# Nao faz: o `-s` do BusyBox mdev so percorre /sys criando NOS de dispositivo,
# sem ambiente nenhum (`make_device(NULL, path, OP_add)` em
# util-linux/mdev.c). A regra `$MODALIAS=.*` de /etc/mdev.conf so casa em
# evento de HOTPLUG, que traz MODALIAS no ambiente. Resultado no aparelho:
#
#   S05modules: coldplug concluido (0 modulo(s) carregado(s))
#
# Agora o script varre os arquivos `modalias` na mao, que e' o que o
# `udevadm trigger` faz: para cada dispositivo SEM driver ligado, pedir o
# modulo pelo alias.
#
# NAO escreve em /etc (raiz SquashFS, somente leitura). Nunca aborta o boot.
set -u

TAG=S05modules
CARREGADOS=0
TENTADOS=0
FALHAS=0

log() {
    echo "$TAG: $*" >&2
    logger -t "$TAG" -- "$*" 2>/dev/null || true
}

if ! command -v modprobe >/dev/null 2>&1; then
    log "aviso: modprobe ausente; nenhum modulo sera carregado"
    exit 0
fi

# /lib/modules/<release> tem de existir, senao modprobe nao acha nada e o
# erro ("module not found") nao diz que o problema e' a versao.
rel=$(uname -r 2>/dev/null || echo "")
if [ -n "$rel" ] && [ ! -d "/lib/modules/$rel" ]; then
    log "aviso: /lib/modules/$rel ausente (kernel nao casa com os modulos)"
    exit 0
fi

# Quantos .ko existem: se for 0, o problema e' a imagem, nao o coldplug.
total_ko=$(find /lib/modules/"$rel" -name '*.ko' 2>/dev/null | wc -l)
[ "$total_ko" -gt 0 ] || log "aviso: nenhum .ko em /lib/modules/$rel"

# ---------------------------------------------------------------- coldplug
# /sys/bus/*/devices/*/modalias cobre os dispositivos que o kernel conhece.
# Pular quem JA tem driver ligado e' o que torna isto barato: depois que os
# drivers embutidos bindam, sobram poucos candidatos.
for m in /sys/bus/*/devices/*/modalias; do
    [ -s "$m" ] || continue

    dev=${m%/modalias}
    # Driver ja ligado: nao ha o que carregar.
    [ -e "$dev/driver" ] && continue

    alias_name=$(sed -n '1p' "$m" 2>/dev/null) || continue
    [ -n "$alias_name" ] || continue

    TENTADOS=$((TENTADOS + 1))
    # -q: sem mensagem para modalias que nenhum modulo cobre (a maioria).
    if modprobe -q "$alias_name" 2>/dev/null; then
        CARREGADOS=$((CARREGADOS + 1))
    else
        FALHAS=$((FALHAS + 1))
    fi
done

# Modulos que nenhum modalias cobre (nao sao driver de dispositivo) e sem os
# quais uma funcao do sistema fica muda. Lista curta de proposito.
for mod in zram; do
    modprobe "$mod" 2>/dev/null || true
done

# mdev -s continua util: cria os NOS de /dev para quem nao tem regra propria em
# /etc/mdev.conf. Nao carrega modulo (ver o cabecalho).
if command -v mdev >/dev/null 2>&1; then
    mdev -s 2>/dev/null || true
fi

carregados_agora=$(wc -l </proc/modules 2>/dev/null || echo 0)
if [ "$CARREGADOS" -eq 0 ] && [ "$TENTADOS" -gt 0 ] && [ "$total_ko" -gt 0 ]; then
    # Sintoma que aparece se o modules.dep estiver quebrado ou o kernel nao
    # casar com /lib/modules: o build passa e o aparelho fica sem driver.
    log "aviso: $TENTADOS alias(es) tentado(s) e nenhum modulo carregado (ver modules.dep)"
fi

log "coldplug: $CARREGADOS de $TENTADOS alias(es); $carregados_agora modulo(s) ativo(s); $total_ko .ko na imagem"
exit 0
