#!/bin/sh
# Giochi Konsol OS v1.2 — S10storage (secao 1.3).
#
# Slot 2 e EXCLUSIVO: modo A (swap dedicado / RAID swap com o Slot 1) OU
# modo B (/user2 estendido). Nunca ambos — o modo e decidido aqui e registrado
# em /run/giochi/slot2_mode para o S30swap nao adivinhar.
#
# DECISAO: a deteccao usa marcadores objetivos do proprio conteudo, sem
# inventar campo em settings.json (proibido pela secao 4.9.5):
#   1. TYPE=swap                      -> modo A (swapon direto)
#   2. arquivo /.giochi-slot2-mode    -> conteudo A|B (marcador explicito)
#   3. arquivo /swapfile presente     -> modo A (hospeda o swapfile)
#   4. ext4/f2fs sem marcador         -> modo B (/user2)
set -u

TAG=S10storage
USER2=${USER2_MNT:-/user2}
SWAP2=${SWAP2_MNT:-/mnt/swap2}

# POSIX: '.' que falha ABORTA shells nao-interativos (o '|| true' nao
# protege). Sem o lib.sh o script segue com os defaults propria.
if [ -r /etc/giochi/lib.sh ]; then
    . /etc/giochi/lib.sh
fi

log() { logger -t "$TAG" -- "$*" 2>/dev/null || echo "$TAG: $*" >&2; }

mkdir -p /run/giochi 2>/dev/null || true
echo B > /run/giochi/slot2_mode 2>/dev/null || true   # default sem slot 2

# Slot 2 = cartao que NAO contem a raiz (secao 1.3). Sem ele, nada a fazer.
if [ -z "${SLOT2_PART:-}" ]; then
    other=$(giochi_other_disk) || { log "slot 2 ausente"; exit 0; }
    SLOT2_PART="${other}p1"
fi
PART=$SLOT2_PART

[ -b "$PART" ] || { log "slot 2 ausente ($PART)"; exit 0; }

fs_type() { blkid "$PART" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p'; }
TYPE=$(fs_type)

mode_from_marker() {
    _mnt=$1
    [ -f "$_mnt/.giochi-slot2-mode" ] || return 1
    _m=$(tr -d '[:space:]' < "$_mnt/.giochi-slot2-mode" 2>/dev/null | cut -c1)
    case "$_m" in
        A|B) echo "$_m"; return 0 ;;
        *)   return 1 ;;
    esac
}

mount_ro() {
    mkdir -p "$1" 2>/dev/null
    mount -t "$TYPE" -o ro,noatime "$PART" "$1" 2>/dev/null
}

mount_rw() {
    mkdir -p "$1" 2>/dev/null
    mount -t "$TYPE" -o rw,noatime "$PART" "$1" 2>/dev/null
}

case "$TYPE" in
    swap)
        log "slot 2 = modo A (particao de swap)"
        swapon -p 10 "$PART" 2>/dev/null || log "aviso: swapon $PART falhou"
        echo A > /run/giochi/slot2_mode
        exit 0
        ;;
    ext4|f2fs|ext3)
        ;;
    "")
        log "slot 2 sem filesystem reconhecivel; ignorado"
        exit 0
        ;;
    *)
        log "slot 2 com FS '$TYPE' nao suportado; ignorado"
        exit 0
        ;;
esac

# Inspeciona o conteudo: marcador explicito, swapfile ou /user2.
if mount_ro "$SWAP2"; then
    mode=$(mode_from_marker "$SWAP2" 2>/dev/null) || mode=""
    has_swap=0
    [ -f "$SWAP2/swapfile" ] && has_swap=1
    umount "$SWAP2" 2>/dev/null || true
else
    log "aviso: nao foi possivel montar $PART para inspecao"
    exit 0
fi

if [ -z "${mode:-}" ]; then
    [ "$has_swap" = "1" ] && mode=A || mode=B
fi

if [ "$mode" = "A" ]; then
    log "slot 2 = modo A (swapfile dedicado)"
    mkdir -p "$SWAP2"
    if mount_rw "$SWAP2"; then
        echo A > /run/giochi/slot2_mode
        export SD2="$SWAP2"   # consumido pelo S30swap
    else
        log "aviso: falha ao montar $SWAP2 rw; slot 2 desativado"
        echo B > /run/giochi/slot2_mode
    fi
    exit 0
fi

log "slot 2 = modo B (/user2)"
mkdir -p "$USER2"
if mount_rw "$USER2"; then
    echo B > /run/giochi/slot2_mode
else
    log "aviso: falha ao montar /user2; seguindo sem slot 2"
    echo B > /run/giochi/slot2_mode
fi
exit 0
