#!/bin/sh
# Giochi Konsol OS v1.2 — S10storage (secao 1.3).
#
# Slot 2 e EXCLUSIVO: modo A (swap dedicado / RAID swap com o Slot 1) OU
# modo B (/user2 estendido). Nunca ambos — o modo e decidido aqui e registrado
# em /run/giochi/slot2_mode para o S30swap nao adivinhar.
#
# DECISAO: a deteccao usa marcadores objetivos do proprio conteudo, sem
# inventar campo em settings.json (proibido pela secao 4.9.5):
#   1. TYPE=swap                      -> modo A (swapon direto)
#   2. arquivo /.giochi-slot2-mode    -> conteudo A|B (marcador explicito)
#   3. arquivo /swapfile presente     -> modo A (hospeda o swapfile)
#   4. ext4/f2fs sem marcador         -> modo B (/user2)
set -u

TAG=S10storage
USER2=${USER2_MNT:-/user2}
SWAP2=${SWAP2_MNT:-/mnt/swap2}

# POSIX: '.' que falha ABORTA shells nao-interativos (o '|| true' nao
# protege). Sem o lib.sh o script segue com os defaults propria.
if [ -r /etc/giochi/lib.sh ]; then
    . /etc/giochi/lib.sh
fi

log() { logger -t "$TAG" -- "$*" 2>/dev/null || echo "$TAG: $*" >&2; }

mkdir -p /run/giochi 2>/dev/null || true

# Arvore padrao da particao C. Sem isto /user/music e /user/games nao
# existem: eles estao no SquashFS, mas /user e o ponto de montagem de
# user.ext4, que e criado VAZIO (post-image.sh). No boot real da X55 o
# Launcher registrou "musica: diretorio '/user/music' inacessivel" e
# "biblioteca: '/user/games' inacessivel" — 0 pacotes, sem nenhum erro.
#
# /user e montado pelo 'mount -a' do inittab (fstab LABEL=GIOCHI_USER) ANTES
# do rcS, entao aqui nao ha o que montar. Falha aqui nao derruba o boot: so
# registra, e o Launcher segue com a biblioteca vazia.
seed_user_tree() {
    _u=${USER_DIR:-/user}
    mkdir -p "$_u/music" "$_u/games" "$_u/ports" "$_u/saves" \
             "$_u/.giochi" "$_u/.cache/meta" "$_u/.cache/thumbs" \
             2>/dev/null || true
    # /user/apps: o alvo do symlink /apps (post-build.sh) — os programas do
    # projeto moram em /apps (convencao do repositorio: apps/). O supervisor
    # procura /apps/giochi-launcher ANTES do binario da imagem, entao basta o
    # usuario colocar o binario aqui (via MTP/SSH) para atualizar a UI sem
    # regravar o sistema (docs/LAUNCHER-APP.md).
    mkdir -p "$_u/apps" 2>/dev/null || true
    mkdir -p -m 700 "$_u/.ssh" 2>/dev/null || true
    # Teste de escrita de verdade: 'mkdir -p' de um diretorio que ja existe
    # DENTRO do SquashFS devolve 0 mesmo com a particao fora do ar, e o log
    # diria "pronta" mentindo.
    if : >"$_u/.giochi/boot-write-test" 2>/dev/null; then
        rm -f "$_u/.giochi/boot-write-test"
        log "arvore de /user pronta (music, games, ports, saves, .giochi)"
    else
        log "aviso: /user nao gravavel; biblioteca e musica ficam vazias"
    fi
}
echo B > /run/giochi/slot2_mode 2>/dev/null || true   # default sem slot 2

# /user vem do fstab (LABEL=GIOCHI_USER), montado pelo mount -a do inittab
# antes do rcS. Aqui so garantimos a arvore de diretorios dentro dele.
seed_user_tree

# Slot 2 = cartao que NAO contem a raiz (secao 1.3). Sem ele, nada a fazer.
if [ -z "${SLOT2_PART:-}" ]; then
    if ! other=$(giochi_other_disk); then
        # Distinguir os dois casos importa para o usuario: "nao ha' segundo
        # slot / nao ha' cartao nele" e' diferente de "ha' cartao e ele nao
        # foi usado". Antes a unica mensagem era "slot 2 ausente".
        if [ -n "$(ls /sys/class/mmc_host 2>/dev/null | grep -vx 'mmc[03]')" ]; then
            log "slot 2: nenhum cartao inserido (controlador mmc2 presente)"
        else
            log "slot 2: este aparelho nao tem segundo slot"
        fi
        exit 0
    fi
    # A particao NAO e' sempre p1, e o nome depende do tipo de dispositivo
    # (`/dev/mmcblk2p1` x `/dev/sda1`). A versao anterior montava "p1" em
    # qualquer disco, o que gera caminho inexistente em /dev/sd*.
    SLOT2_PART=$(giochi_first_part "$other") || {
        log "slot 2: $other sem particao (cartao virgem? formate com mkfs.ext4)"
        exit 0
    }
    log "slot 2: cartao em $other, primeira particao $SLOT2_PART"
fi
PART=$SLOT2_PART

[ -b "$PART" ] || { log "slot 2 ausente ($PART)"; exit 0; }

fs_type() { blkid "$PART" 2>/dev/null | sed -n 's/.*TYPE="\([^"]*\)".*/\1/p'; }
TYPE=$(fs_type)

mode_from_marker() {
    _mnt=$1
    [ -f "$_mnt/.giochi-slot2-mode" ] || return 1
    _m=$(tr -d '[:space:]' < "$_mnt/.giochi-slot2-mode" 2>/dev/null | cut -c1)
    case "$_m" in
        A|B) echo "$_m"; return 0 ;;
        *)   return 1 ;;
    esac
}

mount_ro() {
    mkdir -p "$1" 2>/dev/null
    mount -t "$TYPE" -o ro,noatime "$PART" "$1" 2>/dev/null
}

mount_rw() {
    mkdir -p "$1" 2>/dev/null
    mount -t "$TYPE" -o rw,noatime "$PART" "$1" 2>/dev/null
}

case "$TYPE" in
    swap)
        log "slot 2 = modo A (particao de swap)"
        swapon -p 10 "$PART" 2>/dev/null || log "aviso: swapon $PART falhou"
        echo A > /run/giochi/slot2_mode
        exit 0
        ;;
    ext4|f2fs|ext3)
        ;;
    "")
        log "slot 2 sem filesystem reconhecivel; ignorado"
        exit 0
        ;;
    *)
        log "slot 2 com FS '$TYPE' nao suportado; ignorado"
        exit 0
        ;;
esac

# Inspeciona o conteudo: marcador explicito, swapfile ou /user2.
if mount_ro "$SWAP2"; then
    mode=$(mode_from_marker "$SWAP2" 2>/dev/null) || mode=""
    has_swap=0
    [ -f "$SWAP2/swapfile" ] && has_swap=1
    umount "$SWAP2" 2>/dev/null || true
else
    log "aviso: nao foi possivel montar $PART para inspecao"
    exit 0
fi

if [ -z "${mode:-}" ]; then
    [ "$has_swap" = "1" ] && mode=A || mode=B
fi

if [ "$mode" = "A" ]; then
    log "slot 2 = modo A (swapfile dedicado)"
    mkdir -p "$SWAP2"
    if mount_rw "$SWAP2"; then
        echo A > /run/giochi/slot2_mode
        export SD2="$SWAP2"   # consumido pelo S30swap
    else
        log "aviso: falha ao montar $SWAP2 rw; slot 2 desativado"
        echo B > /run/giochi/slot2_mode
    fi
    exit 0
fi

log "slot 2 = modo B (/user2)"
mkdir -p "$USER2"
if mount_rw "$USER2"; then
    echo B > /run/giochi/slot2_mode
else
    log "aviso: falha ao montar /user2; seguindo sem slot 2"
    echo B > /run/giochi/slot2_mode
fi
exit 0
