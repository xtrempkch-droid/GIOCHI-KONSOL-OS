#!/bin/sh
# Giochi Konsol OS v1.2 — giochi-usb-mode (secao 4.6 / 4.9.4).
#
# Reconfigura o gadget configfs do console. Chamado por:
#   - S50usb no boot (modo de /user/settings.json)
#   - giochi-init ao receber "USB_MODE MTP|MASS" em control.sock
#
# IMPORTANTE: a funcao de REDE (ecm/rndis) e SEMPRE anexada ao mesmo config,
# em todos os modos. E por ela que se faz SSH via USB — inclusive quando o
# modo e Mass Storage (MTP e rede nao competem).
#
#   mtp   -> ffs.mtp  + ecm.usb0   (MTP do userspace via umtprd, sob FunctionFS)
#   mass  -> mass_storage.0 + ecm.usb0
#   off   -> gadget desanexado
#
# Uso: giochi-usb-mode <mtp|mass|off>
set -u

MODE=$(echo "${1:-mtp}" | tr 'A-Z' 'a-z')
TAG=giochi-usb
GADGET=${GADGET:-/sys/kernel/config/usb_gadget/giochi}
FFS_DIR=${FFS_DIR:-/dev/ffs-mtp}
FFS_NAME=${FFS_NAME:-mtp}
VID=${GIOCHI_USB_VID:-0x1d6b}
PID=${GIOCHI_USB_PID:-0x0104}
NET_FUNCTION=${GIOCHI_USB_NET:-ecm}
SERIAL_FILE=/user/.giochi/serial
MTPSVC=${MTPSVC:-/usr/sbin/giochi-mtpd}
DRY=${GIOCHI_DRY_RUN:-0}
# Marcado quando o modo mass desmonta /user; `restaura_user` usa isto para
# devolver a particao se o gadget nao anexar (AGENTS.md §3.89).
USUARIO_DESMONTADO=0

# POSIX: '.' que falha ABORTA shells nao-interativos (o '|| true' nao
# protege). Sem o lib.sh o script segue com os defaults propria.
if [ -r /etc/giochi/lib.sh ]; then
    . /etc/giochi/lib.sh
fi

if [ -f /etc/giochi/usb-net.conf ]; then
    _net=$(sed -n 's/^GIOCHI_USB_NET=//p' /etc/giochi/usb-net.conf | head -n1)
    [ -n "${_net:-}" ] && NET_FUNCTION=$_net
fi

# Log em DOIS lugares de proposito: o syslog (que o S00bootlog grava no
# cartao) e o stderr — e o rcS roda os scripts com `2>&1 | tee -a $bootlog`,
# entao o stderr chega tambem no serial. Medido nesta sessao: quando o modo
# `mass` desmonta /user, o unico instrumento que sobra e' o serial; um
# "por que o USB nao subiu" que so' existe no cartao custa desligar o
# aparelho e tirar o cartao a cada tentativa.
log() {
    logger -t "$TAG" -- "$*" 2>/dev/null || true
    echo "$TAG: $*" >&2
}

case "$MODE" in
    mtp|mass|off) ;;
    *) log "modo invalido '$MODE' (mtp|mass|off)"; exit 2 ;;
esac

# Aparelho sem USB funcional (X35S/X35H, hardware-e-drivers.md F12).
if [ -f /etc/giochi/usb_gadget_disabled ]; then
    log "USB gadget indisponivel neste aparelho; nada a configurar"
    exit 0
fi

if [ "$DRY" != "1" ]; then
    mountpoint -q /sys/kernel/config 2>/dev/null || \
        mount -t configfs none /sys/kernel/config 2>/dev/null || {
            log "configfs indisponivel"; exit 1; }
fi

[ -d "$GADGET" ] || mkdir -p "$GADGET" || { log "mkdir $GADGET falhou"; exit 1; }
cd "$GADGET" || exit 1

# --- parada limpa: MTP -> desanexa -> desmonta ffs -> remove funcoes ------
[ -x "$MTPSVC" ] && "$MTPSVC" stop >/dev/null 2>&1

if [ -s UDC ] 2>/dev/null; then
    echo "" > UDC 2>/dev/null || true
fi

for link in configs/c.1/*; do
    [ -L "$link" ] && rm -f "$link"
done
for fn in functions/ffs.*; do
    [ -d "$fn" ] && rmdir "$fn" 2>/dev/null
done
[ -d functions/mass_storage.0 ] && rmdir functions/mass_storage.0 2>/dev/null
[ -d functions/ecm.usb0 ] && rmdir functions/ecm.usb0 2>/dev/null
[ -d functions/rndis.usb0 ] && rmdir functions/rndis.usb0 2>/dev/null

if mountpoint -q "$FFS_DIR" 2>/dev/null; then
    umount "$FFS_DIR" 2>/dev/null || log "aviso: falha ao desmontar $FFS_DIR"
fi

if [ "$MODE" = "off" ]; then
    log "gadget desativado"
    exit 0
fi

# --- identificacao --------------------------------------------------------
echo "$VID" > idVendor
echo "$PID" > idProduct
echo 0x0300 > bcdUSB 2>/dev/null || true
echo 0x0100 > bcdDevice

mkdir -p strings/0x409 configs/c.1/strings/0x409
echo "Giochi Konsol OS" > strings/0x409/manufacturer
echo "Giochi" > strings/0x409/product
if [ -r "$SERIAL_FILE" ]; then
    serial=$(tr -d '[:space:]' < "$SERIAL_FILE")
else
    serial="giochi0001"
fi
echo "${serial:-giochi0001}" > strings/0x409/serialnumber
echo "Giochi (MTP+Rede)" > configs/c.1/strings/0x409/configuration
echo 250 > configs/c.1/MaxPower

# --- funcao de rede: SEMPRE presente (SSH via USB) -----------------------
NET_OK=0
if [ "$NET_FUNCTION" = "rndis" ]; then
    if mkdir -p functions/rndis.usb0 2>/dev/null; then
        # Windows associa pelo compatible ID; Linux/macOS ignoram.
        echo "RNDIS" > functions/rndis.usb0/os_desc/interface.rndis/compatible_id 2>/dev/null || true
        echo "5162001" > functions/rndis.usb0/os_desc/interface.rndis/sub_compatible_id 2>/dev/null || true
        NET_OK=1
    fi
fi
if [ "$NET_OK" = "0" ] && mkdir -p functions/ecm.usb0 2>/dev/null; then
    NET_OK=1
fi
if [ "$NET_OK" = "1" ]; then
    # MACs fixos e distintos: o host ve sempre a mesma interface.
    echo "02:47:69:6f:63:68" > functions/${NET_FUNCTION:-ecm}.usb0/dev_addr 2>/dev/null || true
    echo "02:47:69:6f:63:69" > functions/${NET_FUNCTION:-ecm}.usb0/host_addr 2>/dev/null || true
    ln -sf functions/${NET_FUNCTION:-ecm}.usb0 configs/c.1/ 2>/dev/null
    log "rede USB = ${NET_FUNCTION:-ecm} (console 10.55.0.2/24)"
else
    log "aviso: kernel sem funcao de rede USB (ECM/RNDIS)"
fi

# --- funcao de dados: MTP (ffs) ou Mass Storage --------------------------
# A escolha entre MTP e Mass Storage tem de ficar no log COM O MOTIVO. Antes,
# a queda para Mass Storage era uma linha solta ("kernel sem CONFIG_USB_F_FS")
# que nao distinguia "o kernel nao tem F_FS" de "o configfs recusou" nem de
# "o functionfs nao montou" — e o efeito no PC e' o mesmo em tres casos
# diferentes (modo mass, /user desmontada, midia de 0 setores).
#
# QUEM QUEBROU O MTP (medido na X55, 01/11): nao era o kernel sem F_FS — o
# .config tem USB_F_FS=y e USB_CONFIGFS_F_FS=y. Era CONFIG_USB_FUNCTIONFS=y,
# o gadget LEGADO g_ffs: no boot ele chama ffs_single_dev() e marca o unico
# dispositivo FunctionFS como reservado; a partir dai' _ffs_alloc_dev()
# devolve -EBUSY em QUALQUER `mkdir functions/ffs.*`. Ver o fragmento de
# kernel e AGENTS.md §3.94.
MTP_OK=0
if [ "$MODE" = "mtp" ]; then
    if mkdir -p "functions/ffs.$FFS_NAME" 2>/dev/null; then
        if [ "$DRY" = "1" ]; then
            MTP_OK=1
        else
            mkdir -p "$FFS_DIR"
            # Quando o mount FALHA o kernel diz por que; `2>/dev/null` era o
            # que transformava "functionfs nao montou" numa linha sem causa.
            if _erro=$(mount -t functionfs "$FFS_NAME" "$FFS_DIR" 2>&1); then
                # Os ep* (e o ep0) so' aparecem depois do mount; conferir aqui
                # evita passar adiante um MTP que o daemon nao vai conseguir
                # abrir, e o log diz exatamente o que faltou.
                if [ ! -e "$FFS_DIR/ep0" ]; then
                    log "aviso: functionfs montou em $FFS_DIR mas sem ep0; segue so' com a rede"
                    MTP_FALHOU=ep0
                else
                    MTP_OK=1
                fi
            else
                log "aviso: functionfs nao montou em $FFS_DIR (${_erro:-sem mensagem}); segue so' com a rede"
                MTP_FALHOU=mount
            fi
        fi
        if [ "$MTP_OK" = "1" ]; then
            ln -sf "functions/ffs.$FFS_NAME" configs/c.1/ 2>/dev/null
        else
            rmdir "functions/ffs.$FFS_NAME" 2>/dev/null
        fi
    else
        log "aviso: configfs recusou ffs.$FFS_NAME (CONFIG_USB_FUNCTIONFS=y reserva o FunctionFS?); segue so' com a rede"
        MTP_FALHOU=configfs
    fi
    # NAO cair para Mass Storage automaticamente. O modo `mass` DESMONTA
    # /user (necessario: dois donos do mesmo ext4 corrompem), e isso derruba
    # junto as chaves do dropbear (/etc/dropbear -> /user/.ssh), a biblioteca
    # e a musica. Medido: com a queda automatica, o boot terminava com
    # `S62sshd: falha ao gerar chave ed25519` e `sem chave e sem senha`,
    # mesmo com o Modo Desenvolvedor ligado e o usb0 com IP.
    #
    # Mass Storage e' ESCOLHA do usuario (menu do Launcher / USB_MODE MASS).
    # Um fallback automatico no boot nunca deve trocar "nao tem MTP" por
    # "perdeu a particao de dados".
    if [ "${MTP_FALHOU:-}" != "" ]; then
        MODO_SEM_DADOS=1
        log "MTP indisponivel ($MTP_FALHOU): gadget so' com rede (Mass Storage exigiria desmontar /user)"
    fi
fi

if [ "$MODE" = "mass" ]; then
    user_part=$(giochi_user_part 2>/dev/null)
    # Tem de ser um NO' DE BLOCO: o kernel recusa PARTUUID com "unable to
    # open backing file" e o resultado no PC e' um disco de 0 setores, sem
    # erro em lugar nenhum. Conferir o tipo aqui e' a diferenca entre "o
    # cartao nao aparece" e "o cartao nao aparece por este motivo".
    if [ -z "${user_part:-}" ] || [ ! -b "$user_part" ]; then
        log "Mass Storage indisponivel: particao /user nao resolvida ('${user_part:-vazio}'); mantendo rede"
        user_part=
    fi
    if [ -n "${user_part:-}" ] && mkdir -p functions/mass_storage.0 2>/dev/null; then
        # Mass Storage exige a particao DESMONTADA enquanto conectado: o host
        # monta o sistema de arquivos dela, e dois donos do mesmo ext4
        # corrompem. O desmonte e' necessario — o que NAO podia acontecer e'
        # desmontar e, se o gadget falhar, seguir a sessao inteira sem /user.
        #
        # Medido na X55 (imagem de 01/11): modo `mass`, o desmonte aconteceu,
        # o bind no UDC falhou com "failed to enable ep0out" e o sistema ficou
        # com /user INACESSIVEL ate' o proximo boot:
        #
        #   [1.778] EXT4-fs (mmcblk1p4): mounted filesystem ... r/w
        #   [5.698] EXT4-fs (mmcblk1p4): unmounting filesystem ...
        #   [6.278] E: nao foi possivel gravar /user/.giochi/device_profile.json
        #   [6.326] I: settings.json ausente; usando defaults
        #   [6.602] I: biblioteca: 0 pacotes em /user/games
        #
        # Ou seja: o cartao inteiro "sumia" por causa de um modo de USB que
        # nem chegou a funcionar. AGENTS.md §3.89.
        if mountpoint -q /user 2>/dev/null; then
            sync
            if umount /user 2>/dev/null; then
                USUARIO_DESMONTADO=1
            else
                log "aviso: /user em uso; desmonte antes de usar Mass Storage"
            fi
        fi
        echo 0 > functions/mass_storage.0/stall
        echo 1 > functions/mass_storage.0/lun.0/removable
        # O `echo > arquivo` do sysfs falha sem barulho quando o no' nao
        # aceita o valor (particao ainda ocupada, caminho inexistente), e o
        # resultado e' um disco de 0 setores anunciado ao PC — medido na X55:
        # `lsusb` mostrava Mass Storage e `lsblk` mostrava `sde 0B`, sem uma
        # linha de erro em lugar nenhum. Conferir aqui troca "o cartao nao
        # aparece no PC" por "o cartao falhou por este motivo".
        if ! echo "$user_part" > functions/mass_storage.0/lun.0/file 2>/dev/null; then
            log "ERRO: nao foi possivel anexar $user_part ao Mass Storage"
            MASS_FALHOU=1
        elif [ "$(cat functions/mass_storage.0/lun.0/file 2>/dev/null)" != "$user_part" ]; then
            log "ERRO: Mass Storage nao aceitou $user_part (leitura de volta vazia)"
            MASS_FALHOU=1
        fi
        if [ "${MASS_FALHOU:-0}" = "1" ]; then
            # Sem midia o PC ve um disco de 0 setores: melhor nao anunciar
            # funcao nenhuma e ficar so' com a rede (que ja' esta ligada).
            # configfs nao aceita rmdir de diretorio com subdiretorio: lun.0
            # sai primeiro, senao o `rmdir` falha calado e a funcao fica.
            rmdir functions/mass_storage.0/lun.0 2>/dev/null
            rmdir functions/mass_storage.0 2>/dev/null
            log "Mass Storage desativado; mantendo MTP/rede"
            # Nada vai ser entregue ao PC: devolver /user agora, senao o
            # desmonte feito acima deixa o sistema sem a particao de dados
            # sem nenhum ganho.
            if [ "${USUARIO_DESMONTADO:-0}" = "1" ]; then
                if mount /user 2>/dev/null; then
                    USUARIO_DESMONTADO=0
                    log "/user remontada (Mass Storage falhou)"
                else
                    log "ERRO: /user continua desmontada; reinicie o aparelho"
                fi
            fi
        else
            ln -sf functions/mass_storage.0 configs/c.1/ || {
                log "nao foi possivel vincular f_mass_storage"; exit 1; }
        fi
    else
        log "sem particao /user para Mass Storage; mantendo apenas rede"
    fi
fi

# --- devolve /user quando o gadget NAO funcionou --------------------------
# O modo mass desmonta /user (dois donos do mesmo ext4 corrompem). Se o bind
# no UDC falhar, o host nunca monta nada e a particao fica sem dono: o
# aparelho segue com /user inacessivel, sem settings, sem jogos e sem musica,
# e o unico jeito de voltar e' reiniciar. Devolver o ponto de montagem aqui
# transforma "perdi o cartao ate' o proximo boot" em "o USB nao funcionou".
restaura_user() {
    [ "${USUARIO_DESMONTADO:-0}" = "1" ] || return 0
    mountpoint -q /user 2>/dev/null && return 0
    if mount /user 2>/dev/null; then
        log "/user remontada (o gadget nao anexou)"
    else
        log "ERRO: /user continua desmontada; reinicie o aparelho"
    fi
}

# --- responder MTP: OBRIGATORIAMENTE antes do bind no UDC -----------------
# FunctionFS nao aceita bind sem descritores: `ffs_func_bind` chama
# `ffs_do_functionfs_bind()`, que faz
#
#     ret = ffs_opts->dev->desc_ready ? 0 : -ENODEV;
#
# e `desc_ready` so' fica verdadeiro depois que o daemon do userspace
# escreve os descritores no ep0. Subir o umtprd DEPOIS do `echo > UDC` da'
# exatamente -19, e o log do kernel nao ajuda em nada:
#
#   udc fcc00000.usb: failed to start giochi: -19
#   UDC core: giochi: couldn't find an available UDC or it's busy
#   sh: write error: Resource busy
#
# (a ultima linha e' o nosso `echo`, e "busy" e' falso: o UDC estava livre).
# Medido na X55 na primeira imagem com o ffs funcionando (01/11).
if [ "$MODE" = "mtp" ] && [ "$MTP_OK" = "1" ] && [ "$DRY" != "1" ]; then
    if [ -x "$MTPSVC" ]; then
        if "$MTPSVC" start; then
            MTPD_OK=1
        else
            log "aviso: umtprd nao iniciou; MTP nao respondera"
            MTP_OK=0
        fi
    else
        log "aviso: giochi-mtpd ausente; MTP nao respondera"
        MTP_OK=0
    fi
fi

# --- anexa ao controlador -------------------------------------------------
udc=${GIOCHI_UDC:-$(ls /sys/class/udc 2>/dev/null | head -n1)}
if [ -z "${udc:-}" ]; then
    log "nenhum UDC disponivel; gadget configurado mas inativo"
    restaura_user
    exit 0
fi
if [ "$DRY" = "1" ]; then
    log "dry-run: anexaria em $udc (modo $MODE)"
else
    if ! echo "$udc" > UDC; then
        log "falha ao anexar ao UDC $udc"
        # -19 aqui e' "o FunctionFS nao tem descritores" (ver acima); o daemon
        # morreu entre o start e o bind, ou o ep0 nao aceitou o descritor.
        if [ "$MODE" = "mtp" ] && [ "${MTPD_OK:-0}" = "1" ]; then
            log "  causa provavel: o umtprd nao escreveu os descritores em $FFS_DIR/ep0 (ver /run/giochi/umtprd.log)"
        fi
        [ -x "$MTPSVC" ] && "$MTPSVC" stop >/dev/null 2>&1
        restaura_user
        exit 1
    fi
    log "gadget anexado em $udc (modo efetivo: $([ "${MODO_SEM_DADOS:-0}" = "1" ] && echo rede || echo "$MODE"), rede=$NET_OK, mtp=$MTP_OK)"
fi

exit 0
