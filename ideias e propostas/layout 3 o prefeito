<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>HandheldOS — Launcher</title>
<style>
:root{
  --bg:#070a12; --panel:#0f1621; --panel2:#1a2436; --card:#22304a;
  --line:rgba(120,160,200,0.12); --line2:rgba(120,160,200,0.3);
  --accent:#66c0f4; --ok:#10b981; --warn:#f59e0b; --danger:#ef4444;
  --text:#f1f5f9; --dim:#94a3b8; --faint:rgba(148,163,184,0.55);
  --font:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --mono:ui-monospace,Menlo,monospace;
  --glow:#66c0f4;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#000;color:var(--text);font-family:var(--font);user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent}
#canvas{position:absolute;width:1280px;height:720px;transform-origin:top left;overflow:hidden}
#ambient{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 0%,var(--glow) 0%,transparent 65%),radial-gradient(ellipse 60% 50% at 15% 90%,rgba(120,60,180,0.08) 0%,transparent 60%),var(--bg);opacity:0.55;transition:background 350ms ease}
#safe{position:absolute;left:160px;top:0;width:960px;height:720px;display:grid;grid-template-rows:56px 610px 54px;padding:0 6px}

/* TOP BAR */
.topbar{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);padding:0 2px}
.tabs{display:flex;gap:3px}
.tab{padding:7px 14px;border-radius:7px;font-size:12px;font-weight:500;color:var(--dim);background:transparent;border:1px solid transparent;cursor:pointer;font-family:var(--font);transition:color .15s,background .15s}
.tab:hover{color:var(--text)}
.tab.on{color:var(--text);background:var(--card);border-color:var(--line2)}
.status{display:flex;align-items:center;gap:10px;font-size:11px;font-weight:600}
.badge{display:flex;align-items:center;gap:5px;padding:5px 10px;border-radius:99px;background:rgba(0,0,0,0.4);border:1px solid var(--line);font-family:var(--mono);font-size:11px}
.bat-dot{width:6px;height:6px;border-radius:50%;background:var(--ok)}
.bat-dot.warn{background:var(--warn)}
.bat-dot.low{background:var(--danger)}
.clock{font-family:var(--mono);font-size:13px;letter-spacing:0.4px}
.icon-btn{width:30px;height:30px;border-radius:6px;background:transparent;border:1px solid transparent;color:var(--dim);cursor:pointer;display:flex;align-items:center;justify-content:center;position:relative}
.icon-btn:hover{color:var(--text);border-color:var(--line2)}
.icon-btn.power{background:rgba(239,68,68,0.12);border-color:rgba(239,68,68,0.35);color:var(--danger)}
.icon-btn.power:hover{background:rgba(239,68,68,0.22)}
.ring{position:absolute;inset:-3px;width:36px;height:36px;pointer-events:none}
.ring circle{stroke-linecap:round}

/* MAIN */
#main{position:relative;overflow:hidden;padding:8px 4px}
.view{height:100%;animation:fadeIn .2s ease}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}

/* HOME / CAROUSEL */
.home{position:relative;height:100%;display:flex;flex-direction:column}
.carousel{position:relative;flex:1;overflow:hidden}
.ccard{position:absolute;top:50%;left:50%;width:520px;height:320px;border-radius:18px;background:linear-gradient(135deg,var(--c1),var(--c2));border:1px solid rgba(255,255,255,0.06);overflow:hidden;cursor:pointer;will-change:transform,opacity}
.ccard::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 25%,var(--g),transparent 55%);opacity:0.18}
.ccard-letter{position:absolute;top:6px;right:22px;font-size:200px;font-weight:900;color:rgba(255,255,255,0.055);line-height:1;pointer-events:none;font-family:var(--font)}
.ccard-body{position:absolute;inset:0;padding:22px 24px;display:flex;flex-direction:column;justify-content:flex-end}
.ccard-cat{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1.2px;color:var(--g);margin-bottom:6px}
.ccard-title{font-size:26px;font-weight:800;color:white;line-height:1.1;margin-bottom:4px;text-shadow:0 2px 12px rgba(0,0,0,0.4)}
.ccard-meta{font-size:11px;color:rgba(255,255,255,0.65);margin-bottom:14px}
.ccard-play{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.28);border-radius:8px;color:white;font-size:11px;font-weight:700;align-self:flex-start;cursor:pointer;font-family:var(--font)}
.ccard.focused{border:2px solid var(--g);box-shadow:0 0 40px -8px var(--g)}
.ccard-ghost{opacity:0.35;pointer-events:none}

.dots{display:flex;justify-content:center;gap:5px;margin:10px 0 6px}
.dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,0.15);transition:background .2s,width .2s}
.dot.on{background:var(--glow);width:20px;border-radius:3px}

.context{text-align:center;padding:0 20px;font-size:11px;color:var(--dim);font-family:var(--mono)}
.context strong{color:var(--text)}

/* LIBRARY */
.lib-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
.lib-title{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--dim)}
.filters{display:flex;gap:5px}
.chip{padding:4px 11px;border-radius:99px;font-size:10px;font-weight:600;background:transparent;border:1px solid var(--line);color:var(--dim);cursor:pointer;font-family:var(--font)}
.chip.on{background:var(--card);border-color:var(--line2);color:var(--text)}
.chip.focused{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:-2px;color:var(--accent)}
.grid{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(2,1fr);gap:9px;flex:1;min-height:0}
.gcard{position:relative;border-radius:10px;border:1px solid rgba(255,255,255,0.06);background:linear-gradient(135deg,var(--c1),var(--c2));padding:11px;display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;overflow:hidden;transition:transform .15s}
.gcard::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 70% 20%,var(--g),transparent 50%);opacity:0.15}
.gcard.focused{border-color:var(--g);outline:1px solid var(--g);outline-offset:-3px;transform:translateY(-2px)}
.gcard-cat{position:relative;font-size:8px;font-weight:800;text-transform:uppercase;letter-spacing:0.5px;color:var(--g);align-self:flex-start;padding:2px 6px;border-radius:3px;background:rgba(0,0,0,0.4)}
.gcard-info{position:relative}
.gcard-title{font-size:13px;font-weight:700;color:white;line-height:1.15}
.gcard-meta{font-size:9px;color:rgba(255,255,255,0.55);margin-top:2px;font-family:var(--mono)}
.gcard-fav{position:absolute;top:8px;right:8px;color:var(--warn);font-size:11px;z-index:2}

/* APPS */
.apps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;height:100%}
.acard{padding:14px;border-radius:10px;border:1px solid var(--line);background:var(--panel2);display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;cursor:pointer;transition:transform .15s,border-color .15s}
.acard.focused{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:-3px;transform:translateY(-2px)}
.acard-icon{font-size:26px;line-height:1}
.acard-title{font-size:12px;font-weight:700;color:var(--text)}
.acard-cat{font-size:9px;color:var(--dim);font-family:var(--mono)}

/* SETTINGS */
.settings{display:grid;grid-template-columns:230px 1fr;gap:14px;height:100%;padding-top:6px}
.side{display:flex;flex-direction:column;gap:3px;border-right:1px solid var(--line);padding-right:12px}
.scat{padding:9px 11px;border-radius:7px;font-size:11px;font-weight:600;color:var(--dim);background:transparent;border:1px solid transparent;text-align:left;cursor:pointer;font-family:var(--font);transition:background .15s,color .15s}
.scat:hover{color:var(--text);background:rgba(255,255,255,0.03)}
.scat.on{color:var(--accent);background:var(--card);border-color:var(--line2)}
.scat.focused{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:-2px;color:var(--accent)}
.scontent{overflow-y:auto;padding-right:4px}
.scontent h4{font-size:12px;font-weight:700;color:var(--text);margin-bottom:10px}
.srow{padding:10px 12px;border-radius:8px;background:rgba(0,0,0,0.25);border:1px solid var(--line);margin-bottom:7px;display:flex;justify-content:space-between;align-items:center;font-size:11px}
.srow strong{display:block;font-weight:600;color:var(--text);margin-bottom:1px;font-size:11px}
.srow small{font-size:9px;color:var(--dim);font-family:var(--mono)}
.sval{color:var(--accent);font-family:var(--mono);font-weight:700}

/* FOOTER */
.foot{display:flex;align-items:center;justify-content:space-between;padding:0 2px;border-top:1px solid var(--line);font-size:10px;color:var(--dim)}
.hints{display:flex;gap:11px}
.hint{display:flex;align-items:center;gap:4px}
.hint kbd{display:inline-flex;align-items:center;justify-content:center;min-width:17px;height:15px;padding:0 4px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.14);border-radius:3px;font-size:9px;font-weight:700;color:var(--accent);font-family:var(--mono)}
.build{font-family:var(--mono);font-size:9px;color:var(--faint)}

/* OVERLAYS */
.ov{position:absolute;inset:0;background:rgba(0,0,0,0.78);display:flex;align-items:center;justify-content:center;animation:fadeIn .18s ease;z-index:50}
.panel{background:var(--panel);border:1px solid var(--line2);border-radius:16px;overflow:hidden}
.panel-head{padding:12px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px;color:var(--accent);font-size:13px;font-weight:700}
.panel-head h3{color:var(--text);font-size:13px;font-weight:700}

/* SEARCH */
.search{width:900px;max-height:560px;display:flex;flex-direction:column}
.search-input{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid var(--line);color:var(--accent)}
.search-input .q{flex:1;font-size:16px;font-weight:600;color:var(--text);font-family:var(--font);min-height:22px}
.search-input .q.empty{color:var(--faint);font-weight:400}
.search-body{display:grid;grid-template-columns:1fr 380px;gap:14px;padding:14px;flex:1;min-height:0}
.kbd{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.key{aspect-ratio:1.3;border-radius:7px;background:var(--panel2);border:1px solid var(--line);color:var(--text);font-size:13px;font-weight:600;display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:var(--mono);transition:background .1s,border-color .1s}
.key.wide{aspect-ratio:auto;height:100%;min-height:36px;font-size:11px}
.key.wide.small{font-size:10px}
.key.focused{border-color:var(--accent);background:var(--card);color:var(--accent);outline:1px solid var(--accent);outline-offset:-2px}
.results{overflow-y:auto}
.res-title{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.8px;color:var(--dim);margin-bottom:8px}
.res-item{padding:9px 11px;border-radius:7px;background:var(--panel2);border:1px solid var(--line);margin-bottom:5px;display:flex;gap:10px;align-items:center;cursor:pointer}
.res-item.focused{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:-2px}
.res-dot{width:28px;height:28px;border-radius:5px;background:linear-gradient(135deg,var(--c1),var(--c2));flex-shrink:0}
.res-name{font-size:11px;font-weight:600;color:var(--text)}
.res-cat{font-size:9px;color:var(--dim);font-family:var(--mono)}
.res-empty{text-align:center;padding:20px;color:var(--faint);font-size:11px;font-style:italic}

/* QUICK SETTINGS */
.qs{width:520px}
.qs-rows{padding:8px}
.qs-row{padding:10px 12px;border-radius:8px;background:rgba(0,0,0,0.25);border:1px solid var(--line);margin-bottom:5px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:11px}
.qs-row.focused{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:-2px}
.qs-label{display:flex;align-items:center;gap:8px;color:var(--text);font-weight:600;flex:1}
.qs-label svg{color:var(--accent)}
.qs-val{color:var(--accent);font-family:var(--mono);font-weight:700;font-size:10px;min-width:50px;text-align:right}
.slider{flex:1.5;height:5px;border-radius:3px;background:rgba(255,255,255,0.1);position:relative;overflow:hidden}
.slider-fill{position:absolute;inset:0;width:var(--p);background:var(--accent);border-radius:3px;transition:width .1s}
.perf-tabs{display:flex;gap:4px}
.perf-chip{padding:4px 8px;border-radius:5px;font-size:9px;font-weight:700;background:transparent;border:1px solid var(--line);color:var(--dim);font-family:var(--font)}
.perf-chip.on{background:var(--accent);color:var(--bg);border-color:var(--accent)}
.tgl{width:34px;height:18px;border-radius:99px;background:rgba(255,255,255,0.1);position:relative;transition:background .2s;flex-shrink:0}
.tgl::after{content:'';position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:var(--dim);transition:transform .2s,background .2s}
.tgl.on{background:rgba(102,192,244,0.3)}
.tgl.on::after{transform:translateX(16px);background:var(--accent)}
.qs-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:8px;border-top:1px solid var(--line)}
.qs-btn{padding:9px;border-radius:7px;font-size:11px;font-weight:700;cursor:pointer;font-family:var(--font);background:var(--panel2);border:1px solid var(--line);color:var(--text)}
.qs-btn.focused{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:-2px}
.qs-btn.danger{background:rgba(239,68,68,0.15);border-color:rgba(239,68,68,0.4);color:var(--danger)}

/* GAME DETAIL */
.detail{width:760px}
.detail-hero{padding:22px 24px;background:linear-gradient(135deg,var(--c1),var(--c2));position:relative;overflow:hidden}
.detail-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 25%,var(--g),transparent 55%);opacity:0.2}
.detail-letter{position:absolute;top:-10px;right:20px;font-size:180px;font-weight:900;color:rgba(255,255,255,0.06);line-height:1;font-family:var(--font)}
.detail-hero-content{position:relative;z-index:1}
.detail-cat{font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--g);margin-bottom:5px}
.detail-title{font-size:28px;font-weight:800;color:white;margin-bottom:12px;text-shadow:0 2px 10px rgba(0,0,0,0.4)}
.detail-stats{display:flex;gap:24px;font-family:var(--mono);font-size:9px}
.detail-stats span{color:rgba(255,255,255,0.55);display:block;text-transform:uppercase;letter-spacing:0.5px}
.detail-stats strong{color:white;font-size:16px;margin-top:3px;display:block;font-family:var(--font);font-weight:800}
.detail-actions{padding:12px;display:flex;gap:8px;justify-content:flex-end;border-top:1px solid var(--line)}
.d-btn{padding:9px 18px;border-radius:8px;font-size:11px;font-weight:700;cursor:pointer;font-family:var(--font);background:var(--panel2);border:1px solid var(--line);color:var(--text)}
.d-btn.focused{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:-2px}
.d-btn.primary{background:var(--accent);border-color:var(--accent);color:var(--bg)}

/* POWER */
.power-pop{width:340px;padding:20px;text-align:center}
.power-ico{width:48px;height:48px;border-radius:12px;background:rgba(239,68,68,0.15);color:var(--danger);display:flex;align-items:center;justify-content:center;margin:0 auto 10px}
.power-pop h3{font-size:15px;font-weight:700;margin-bottom:3px}
.power-pop p{font-size:10px;color:var(--dim);margin-bottom:14px}
.power-actions{display:flex;flex-direction:column;gap:5px}
.p-btn{padding:9px;border-radius:7px;font-size:11px;font-weight:700;cursor:pointer;font-family:var(--font);background:var(--panel2);border:1px solid var(--line);color:var(--text)}
.p-btn.focused{border-color:var(--accent);outline:1px solid var(--accent);outline-offset:-2px}
.p-btn.danger{background:rgba(239,68,68,0.9);color:white;border-color:var(--danger)}
.p-btn.ghost{background:transparent;color:var(--dim)}

/* SLEEP + BOOT */
.sleep,.boot,.shut{position:absolute;inset:0;background:#000;z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--dim)}
.sleep{cursor:pointer;animation:fadeIn .3s ease}
.sleep svg{color:var(--accent);opacity:0.5}
.sleep p{font-size:11px}
.boot{gap:20px}
.boot-logo{font-size:32px;font-weight:200;color:var(--accent);letter-spacing:6px;text-transform:uppercase}
.boot-tag{font-size:10px;color:var(--faint);font-family:var(--mono);letter-spacing:1.5px}
.boot-fade{animation:fadeIn .6s ease}
.shut{font-family:var(--mono);font-size:12px;color:var(--faint)}

/* HUD */
.hud{position:absolute;top:66px;right:170px;background:rgba(0,0,0,0.7);border:1px solid var(--line2);border-radius:8px;padding:8px 12px;font-family:var(--mono);font-size:10px;color:var(--accent);display:flex;gap:14px;z-index:5}
.hud-item{display:flex;flex-direction:column;align-items:flex-start}
.hud-item span{color:var(--dim);font-size:8px;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:2px}
.hud-item strong{color:var(--accent);font-weight:700}

/* TOAST */
.toast{position:absolute;bottom:64px;left:50%;transform:translateX(-50%);background:var(--panel);border:1px solid var(--line2);color:var(--text);font-size:11px;padding:9px 16px;border-radius:8px;display:flex;align-items:center;gap:8px;z-index:80;opacity:0;transition:opacity .2s;pointer-events:none}
.toast.on{opacity:1}
.toast svg{color:var(--accent)}
</style>
</head>
<body>

<div id="canvas">
  <div id="ambient"></div>
  <div id="safe">
    <header class="topbar" id="topbar"></header>
    <main id="main"></main>
    <footer class="foot" id="foot"></footer>
  </div>
  <div id="overlays"></div>
</div>

