const ZONE_COLS = {
  'home-carousel': 1,
  'library-grid': 4,
  'library-filters': 3,
  'apps-grid': 4,
  'settings-sidebar': 1,
  'search-keyboard': 7,
  'search-results': 1,
  'quick-settings': 1,
  'game-detail-actions': 4,
  'power-actions': 1,
};

// ══════════════════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════════════════
const initialState = () => ({
  booting: true,
  stack: [{ type:'tab', id:'home' }],
  focus: { zone:'home-carousel', index:0 },
  savedFocus: {},
  games: GAMES_INIT.map(g => ({ ...g })),
  apps: APPS_INIT.map(a => ({ ...a })),
  carouselIdx: 0,
  libraryFilter: 'all',
