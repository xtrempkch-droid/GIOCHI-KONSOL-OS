  searchQuery: '',
  searchFocusedFirst: true, // keyboard = true, results = false
  settings: { volume:70, brightness:80, perf:'balanced', wifi:true, bluetooth:true, hud:false },
  sleeping: false,
  shutdown: false,
  hud: { fps:60, temp:52, tdp:6 },
  toast: { msg:'', on:false, timer:0 },
});

let State = initialState();

// ══════════════════════════════════════════════════════════
// HELPERS
// ══════════════════════════════════════════════════════════
const top = s => s.stack[s.stack.length - 1];
const hasOverlay = s => s.stack.some(x => x.type === 'overlay');
const overlayOpen = (s, id) => s.stack.some(x => x.type === 'overlay' && x.id === id);
const focusedGame = s => s.games[s.carouselIdx];
const filteredGames = s => {
  if (s.libraryFilter === 'fav') return s.games.filter(g => g.favorite);
  if (s.libraryFilter === 'recent') return [...s.games].sort((a,b) => GAMES_INIT.findIndex(g=>g.id===a.id) - GAMES_INIT.findIndex(g=>g.id===b.id));
  return s.games;
};
const searchResults = s => {
  const q = s.searchQuery.trim().toLowerCase();
  if (!q) return [];
  return s.games.filter(g => g.title.toLowerCase().includes(q));
};
const zoneCount = (s, zone) => {
  if (zone === 'home-carousel') return s.games.length;
  if (zone === 'library-grid') return filteredGames(s).length;
  if (zone === 'library-filters') return 3;
  if (zone === 'apps-grid') return s.apps.length;
  if (zone === 'settings-sidebar') return MENU_CATS.length;
  if (zone === 'search-keyboard') return 28;
  if (zone === 'search-results') return Math.max(0, searchResults(s).length);
  if (zone === 'quick-settings') return 8;
  if (zone === 'game-detail-actions') return 4;
  if (zone === 'power-actions') return 4;
  return 0;
};

function showToast(msg) {
  if (State.toast.timer) clearTimeout(State.toast.timer);
  const timer = setTimeout(() => dispatch('HIDE_TOAST'), 2200);
  dispatch('SHOW_TOAST', { msg, timer });
}

// ══════════════════════════════════════════════════════════
// REDUCER
// ══════════════════════════════════════════════════════════
function reduce(state, cmd, p) {
  switch (cmd) {
    case 'NAV_UP': case 'NAV_DOWN': case 'NAV_LEFT': case 'NAV_RIGHT':
      return navigate(state, cmd.replace('NAV_', ''));

    case 'CONFIRM': return confirmAction(state);
    case 'BACK': return goBack(state);
    case 'OPTIONS': return pressX(state);
    case 'SEARCH': return pressY(state);

    case 'TAB_LEFT': return hasOverlay(state) ? state : switchTabRel(state, -1);
    case 'TAB_RIGHT': return hasOverlay(state) ? state : switchTabRel(state, 1);

    case 'TOGGLE_QS': {
      if (overlayOpen(state, 'quick-settings')) return goBack(state);
      if (hasOverlay(state) || state.sleeping) return state;
      return { ...state, stack:[...state.stack, { type:'overlay', id:'quick-settings' }], focus:{ zone:'quick-settings', index:0 } };
    }

    case 'POWER_SHORT':
      if (hasOverlay(state) || state.sleeping) return state;
      return { ...state, sleeping: true };

    case 'POWER_HOLD':
      if (hasOverlay(state) || state.sleeping) return state;
      return { ...state, stack:[...state.stack, { type:'overlay', id:'power-popup' }], focus:{ zone:'power-actions', index:0 } };

    case 'WAKE': return { ...state, sleeping: false };
    case 'REBOOT': return initialState();

    case 'SET_VOLUME': {
      const v = Math.max(0, Math.min(100, p.value));
      return { ...state, settings:{ ...state.settings, volume:v } };
    }
    case 'SET_BRIGHTNESS': {
      const v = Math.max(0, Math.min(100, p.value));
      return { ...state, settings:{ ...state.settings, brightness:v } };
    }
    case 'SET_PERF':
      return { ...state, settings:{ ...state.settings, perf:p.value } };
    case 'TOGGLE_WIFI':
      return { ...state, settings:{ ...state.settings, wifi:!state.settings.wifi } };
    case 'TOGGLE_BT':
      return { ...state, settings:{ ...state.settings, bluetooth:!state.settings.bluetooth } };
    case 'TOGGLE_HUD':
      return { ...state, settings:{ ...state.settings, hud:!state.settings.hud } };
    case 'SET_FILTER':
      return { ...state, libraryFilter:p.value, focus:{ zone:'library-filters', index:p.index } };
    case 'SET_SEARCH_QUERY':
      return { ...state, searchQuery:p.value };
    case 'SET_SEARCH_ZONE':
      return { ...state, searchFocusedFirst:p.keyboard, focus:{ zone:p.keyboard?'search-keyboard':'search-results', index:0 } };
    case 'SHOW_TOAST':
      return { ...state, toast:{ msg:p.msg, on:true, timer:p.timer } };
    case 'HIDE_TOAST':
      return { ...state, toast:{ ...state.toast, on:false } };
    case 'BOOT_DONE':
      return { ...state, booting:false };
    case 'TICK_HUD': {
      const r = (a,b) => Math.round(a + Math.random()*(b-a));
      return { ...state, hud:{ fps:r(56,60), temp:r(48,56), tdp:r(5,8) } };
    }
    default: return state;
  }
}

function navigate(state, dir) {
  const zone = state.focus.zone;
  if (!zone) return state;

  // Zonas horizontais puras
  if (zone === 'home-carousel') {
    if (dir !== 'LEFT' && dir !== 'RIGHT') return state;
    const n = state.games.length;
    const next = (state.carouselIdx + (dir === 'RIGHT' ? 1 : -1) + n) % n;
    return { ...state, carouselIdx:next, focus:{ zone, index:next } };
  }

  // Quick settings: navegação vertical, left/right contextual
  if (zone === 'quick-settings') {
    const row = state.focus.index;
    if (dir === 'UP') return { ...state, focus:{ zone, index:Math.max(0, row-1) } };
    if (dir === 'DOWN') return { ...state, focus:{ zone, index:Math.min(7, row+1) } };
    if (dir === 'LEFT' || dir === 'RIGHT') {
      const d = dir === 'RIGHT' ? 1 : -1;
      if (row === 0) return reduce(state, 'SET_VOLUME', { value:state.settings.volume + d*5 });
      if (row === 1) return reduce(state, 'SET_BRIGHTNESS', { value:state.settings.brightness + d*5 });
      if (row === 2) {
        const modes = ['eco','balanced','boost'];
        const idx = modes.indexOf(state.settings.perf);
        const next = modes[Math.max(0, Math.min(2, idx+d))];
        return reduce(state, 'SET_PERF', { value:next });
      }
    }
    return state;
  }

  // Filtros da library
  if (zone === 'library-filters') {
    if (dir === 'LEFT' || dir === 'RIGHT') {
      const i = Math.max(0, Math.min(2, state.focus.index + (dir==='RIGHT'?1:-1)));
      const vals = ['all','fav','recent'];
      return reduce(state, 'SET_FILTER', { value:vals[i], index:i });
    }
    if (dir === 'DOWN') return { ...state, focus:{ zone:'library-grid', index:0 } };
    return state;
  }

  // Grid genérico
  const cols = ZONE_COLS[zone];
  const count = zoneCount(state, zone);
  if (!cols || count <= 0) return state;

  // UP da library-grid volta pra filtros
  if (zone === 'library-grid' && dir === 'UP' && state.focus.index < cols) {
    return { ...state, focus:{ zone:'library-filters', index:0 } };
  }

  // Zona de resultados: LEFT vai pra keyboard
  if (zone === 'search-results' && dir === 'LEFT') {
    return { ...state, searchFocusedFirst:true, focus:{ zone:'search-keyboard', index:0 } };
  }
  // Keyboard: RIGHT na última coluna vai pra resultados (se houver)
  if (zone === 'search-keyboard' && dir === 'RIGHT') {
    const col = state.focus.index % 7;
    if (col === 6 && searchResults(state).length > 0) {
      return { ...state, searchFocusedFirst:false, focus:{ zone:'search-results', index:0 } };
    }
  }

  const rows = Math.ceil(count / cols);
  const idx = state.focus.index;
  const row = Math.floor(idx / cols), col = idx % cols;
  let r = row, c = col;
  if (dir === 'UP') r = Math.max(0, row-1);
  if (dir === 'DOWN') r = Math.min(rows-1, row+1);
  if (dir === 'LEFT') c = Math.max(0, col-1);
  if (dir === 'RIGHT') c = Math.min(cols-1, col+1);
  let n = r*cols + c;
  if (n >= count) n = count - 1;
  if (n === idx) return state;
  return { ...state, focus:{ zone, index:n } };
}

function confirmAction(state) {
  const zone = state.focus.zone;
  const i = state.focus.index;

  if (zone === 'home-carousel') {
    const g = state.games[state.carouselIdx];
    showToast(`Iniciando ${g.title}...`);
    return state;
  }
  if (zone === 'library-filters') return state;
  if (zone === 'library-grid') {
    const g = filteredGames(state)[i];
    if (!g) return state;
    return {
      ...state,
      selectedGame:g,
      stack:[...state.stack, { type:'overlay', id:'game-detail' }],
      focus:{ zone:'game-detail-actions', index:0 },
    };
  }
  if (zone === 'apps-grid') {
    const app = state.apps[i];
    showToast(`Abrindo ${app.title}...`);
    return state;
  }
  if (zone === 'settings-sidebar') {
    return { ...state, settingsCat: MENU_CATS[i] };
  }
  if (zone === 'search-keyboard') {
    const row = Math.floor(i/7), col = i%7;
    const k = KEYBOARD[row]?.[col];
    if (!k) return state;
    if (k === '⌫') return { ...state, searchQuery: state.searchQuery.slice(0, -1) };
    if (k === '␣') return { ...state, searchQuery: state.searchQuery + ' ' };
    return { ...state, searchQuery: state.searchQuery + k };
  }
  if (zone === 'search-results') {
    const g = searchResults(state)[i];
    if (!g) return state;
    return {
      ...state,
      selectedGame:g,
      stack:[...state.stack, { type:'overlay', id:'game-detail' }],
      focus:{ zone:'game-detail-actions', index:0 },
    };
  }
  if (zone === 'quick-settings') {
    if (i === 3) return reduce(state, 'TOGGLE_WIFI');
    if (i === 4) return reduce(state, 'TOGGLE_BT');
    if (i === 5) return reduce(state, 'TOGGLE_HUD');
    if (i === 6) return { ...state, stack:state.stack.slice(0,-1), sleeping:true };
    if (i === 7) { showToast('Reiniciando...'); return { ...state, stack:state.stack.slice(0,-1), shutdown:true }; }
    return state;
  }
  if (zone === 'game-detail-actions') {
    if (i === 0) { showToast(`Iniciando ${state.selectedGame?.title}...`); return goBack(state); }
    if (i === 1) {
      const g = state.games.find(x => x.id === state.selectedGame?.id);
      if (g) g.favorite = !g.favorite;
      showToast(g?.favorite ? 'Adicionado aos favoritos' : 'Removido dos favoritos');
      return { ...state };
    }
    if (i === 2) { showToast('Opções do jogo'); return state; }
    if (i === 3) return goBack(state);
  }
  if (zone === 'power-actions') {
    if (i === 0) return { ...state, stack:state.stack.slice(0,-1), sleeping:true };
    if (i === 1) { showToast('Reiniciando...'); return { ...state, stack:state.stack.slice(0,-1), shutdown:true }; }
    if (i === 2) { showToast('Desligando...'); return { ...state, stack:state.stack.slice(0,-1), shutdown:true }; }
    if (i === 3) return goBack(state);
  }
  return state;
}

function pressX(state) {
  const zone = state.focus.zone;
  if (zone === 'home-carousel') {
    const g = focusedGame(state);
    return {
      ...state,
      selectedGame:g,
      stack:[...state.stack, { type:'overlay', id:'game-detail' }],
      focus:{ zone:'game-detail-actions', index:0 },
    };
  }
  if (zone === 'library-grid') {
    const g = filteredGames(state)[state.focus.index];
    if (!g) return state;
    return {
      ...state,
      selectedGame:g,
      stack:[...state.stack, { type:'overlay', id:'game-detail' }],
      focus:{ zone:'game-detail-actions', index:0 },
    };
  }
  return state;
}

function pressY(state) {
  if (hasOverlay(state) || state.sleeping) return state;
  return {
    ...state,
    searchQuery:'',
    searchFocusedFirst:true,
    stack:[...state.stack, { type:'overlay', id:'search' }],
    focus:{ zone:'search-keyboard', index:0 },
  };
}

function goBack(state) {
  if (state.stack.length <= 1) return state;
  const newStack = state.stack.slice(0, -1);
  const t = newStack[newStack.length-1];
  let newFocus;
  if (t.type === 'tab') newFocus = { zone:tabZone(t.id), index:0 };
  else newFocus = { zone:overlayZone(t.id), index:0 };
  return { ...state, stack:newStack, focus:newFocus };
}

function switchTab(state, id) {
  return {
    ...state,
    stack:[{ type:'tab', id }],
    focus:{ zone:tabZone(id), index:0 },
  };
}
function switchTabRel(state, d) {
  const cur = state.stack[0].id;
  const i = TABS.indexOf(cur);
  return switchTab(state, TABS[(i + d + TABS.length) % TABS.length]);
}
const tabZone = id => ({ home:'home-carousel', library:'library-grid', apps:'apps-grid', settings:'settings-sidebar' }[id]);
const overlayZone = id => ({ search:'search-keyboard', 'quick-settings':'quick-settings', 'game-detail':'game-detail-actions', 'power-popup':'power-actions' }[id]);

// ══════════════════════════════════════════════════════════
// DISPATCH
// ══════════════════════════════════════════════════════════
function dispatch(cmd, p) {
  const prev = State;
  State = reduce(State, cmd, p);
  if (State !== prev) render();
}

// ══════════════════════════════════════════════════════════
// RENDER
// ══════════════════════════════════════════════════════════
function render() {
  document.getElementById('ambient').style.setProperty('--glow', focusedGame(State).g);
  renderTopBar();
  renderMain();
