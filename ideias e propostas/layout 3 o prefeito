function viewHome() {
  const n = State.games.length;
  const focused = State.carouselIdx;
  const cards = [];
  const used = new Set();
  for (let off = -1; off <= 1; off++) {
    const idx = (focused + off + n) % n;
    if (used.has(idx)) continue;
    used.add(idx);
    const g = State.games[idx];
    const focusedThis = off === 0;
    const scale = focusedThis ? 1 : 0.62;
    const tx = off * 420;
    cards.push(`
      <div class="ccard ${focusedThis?'focused':''} ${!focusedThis?'ccard-ghost':''}"
           data-game-carousel="${idx}"
           style="--c1:${g.c1};--c2:${g.c2};--g:${g.g};transform:translate(-50%,-50%) translateX(${tx}px) scale(${scale});z-index:${10-Math.abs(off)}">
        <div class="ccard-letter">${g.title.charAt(0)}</div>
        <div class="ccard-body">
          <div class="ccard-cat">${g.category}</div>
          <div class="ccard-title">${g.title}</div>
          <div class="ccard-meta">${g.hours.toFixed(1)}h • Última: ${g.last}</div>
          ${focusedThis ? `<button class="ccard-play" data-action="play">${I.play} Continuar</button>` : ''}
        </div>
      </div>
    `);
  }

  const dots = State.games.map((_, i) =>
    `<div class="dot ${i===focused?'on':''}"></div>`
  ).join('');

  const g = State.games[focused];
  return `
    <div class="home">
      <div class="carousel">${cards.join('')}</div>
      <div class="dots">${dots}</div>
      <div class="context">
        <strong>${g.title}</strong> • ${g.category} • ${g.hours.toFixed(1)}h • Última sessão: ${g.last}
