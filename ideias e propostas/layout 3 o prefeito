// POWER HOLD
// ══════════════════════════════════════════════════════════
let pHoldTimer = null, pHoldStart = 0;
const HOLD_MS = 1500, TAP_MS = 400;
function bindPower() {
  const btn = document.getElementById('power-btn');
  if (!btn) return;
  const ring = btn.querySelector('.ring-p');
  const circ = 2*Math.PI*16;
  btn.addEventListener('pointerdown', e => {
    e.preventDefault();
    if (State.sleeping || State.shutdown) return;
    btn.setPointerCapture(e.pointerId);
    pHoldStart = Date.now();
    if (ring) {
      ring.style.transition = 'none';
      ring.style.strokeDashoffset = circ;
      void ring.getBoundingClientRect();
      ring.style.transition = `stroke-dashoffset ${HOLD_MS}ms linear`;
      ring.style.strokeDashoffset = 0;
    }
    pHoldTimer = setTimeout(() => {
      pHoldTimer = null;
      if (ring) { ring.style.transition = 'stroke-dashoffset 0.2s'; ring.style.strokeDashoffset = circ; }
      dispatch('POWER_HOLD');
    }, HOLD_MS);
  });
  const end = e => {
    if (!pHoldTimer) return;
    clearTimeout(pHoldTimer);
    pHoldTimer = null;
    if (ring) { ring.style.transition = 'stroke-dashoffset 0.2s'; ring.style.strokeDashoffset = circ; }
    if (Date.now() - pHoldStart < TAP_MS) dispatch('POWER_SHORT');
  };
  btn.addEventListener('pointerup', end);
  btn.addEventListener('pointercancel', end);
}

