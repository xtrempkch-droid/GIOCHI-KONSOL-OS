const KEYMAP = {
  ArrowUp:'NAV_UP', ArrowDown:'NAV_DOWN', ArrowLeft:'NAV_LEFT', ArrowRight:'NAV_RIGHT',
  Enter:'CONFIRM', ' ':'CONFIRM',
  Escape:'BACK', Backspace:'BACK',
  Tab:'TOGGLE_QS',
  q:'TAB_LEFT', e:'TAB_RIGHT',
  x:'OPTIONS', y:'SEARCH',
  p:'POWER_SHORT',
};

window.addEventListener('keydown', e => {
  if (State.shutdown) {
    if (e.key === 'Enter' || e.key.toLowerCase() === 'p') { e.preventDefault(); dispatch('REBOOT'); }
    return;
  }
  if (State.sleeping) { e.preventDefault(); dispatch('WAKE'); return; }
  if (State.booting) return;

  const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
  const cmd = KEYMAP[k];
  if (cmd) { e.preventDefault(); dispatch(cmd); }
});

document.addEventListener('click', e => {
  if (State.booting) return;

  const tab = e.target.closest('[data-tab]');
  if (tab) { State = switchTab(State, tab.dataset.tab); render(); return; }

  const carousel = e.target.closest('[data-game-carousel]');
  if (carousel) {
    const idx = parseInt(carousel.dataset.gameCarousel);
    if (State.carouselIdx !== idx) {
      State = { ...State, carouselIdx:idx, focus:{ zone:'home-carousel', index:idx } };
      render();
    } else {
      dispatch('CONFIRM');
    }
    return;
  }

  const playBtn = e.target.closest('[data-action="play"]');
  if (playBtn) { e.stopPropagation(); dispatch('CONFIRM'); return; }

  const filterBtn = e.target.closest('[data-filter]');
  if (filterBtn) {
    dispatch('SET_FILTER', { value:filterBtn.dataset.filter, index:parseInt(filterBtn.dataset.filterIdx) });
    return;
  }

  const gcard = e.target.closest('[data-game-grid]');
  if (gcard) {
    const id = parseInt(gcard.dataset.gameGrid);
    const g = State.games.find(x => x.id === id);
    if (!g) return;
    State = { ...State, selectedGame:g, stack:[...State.stack, { type:'overlay', id:'game-detail' }], focus:{ zone:'game-detail-actions', index:0 } };
    render();
    return;
  }

  const acard = e.target.closest('[data-app-idx]');
  if (acard) {
    const i = parseInt(acard.dataset.appIdx);
    State = { ...State, focus:{ zone:'apps-grid', index:i } };
    dispatch('CONFIRM');
    return;
  }

  const scat = e.target.closest('[data-cat]');
  if (scat) {
    State = { ...State, settingsCat:scat.dataset.cat };
    render();
    return;
  }

  if (e.target.closest('[data-action="toggle-qs"]')) { dispatch('TOGGLE_QS'); return; }

  const keyBtn = e.target.closest('[data-key-idx]');
  if (keyBtn) {
    State = { ...State, focus:{ zone:'search-keyboard', index:parseInt(keyBtn.dataset.keyIdx) } };
    dispatch('CONFIRM');
    return;
  }

  const resultBtn = e.target.closest('[data-result-idx]');
  if (resultBtn) {
    State = { ...State, focus:{ zone:'search-results', index:parseInt(resultBtn.dataset.resultIdx) } };
    dispatch('CONFIRM');
    return;
  }

  const qsRow = e.target.closest('[data-qs-row]');
  if (qsRow) { State = { ...State, focus:{ zone:'quick-settings', index:parseInt(qsRow.dataset.qsRow) } }; render(); return; }

  const qsAct = e.target.closest('[data-qs-action]');
  if (qsAct) {
    const a = qsAct.dataset.qsAction;
    if (a === 'sleep') { State = { ...State, stack:State.stack.slice(0,-1), sleeping:true }; render(); }
    if (a === 'restart') { State = { ...State, stack:State.stack.slice(0,-1), shutdown:true }; render(); }
    return;
  }

  const detailBtn = e.target.closest('[data-detail-idx]');
  if (detailBtn) {
    State = { ...State, focus:{ zone:'game-detail-actions', index:parseInt(detailBtn.dataset.detailIdx) } };
    dispatch('CONFIRM');
    return;
  }

  const powerBtn = e.target.closest('[data-power-idx]');
  if (powerBtn) {
    State = { ...State, focus:{ zone:'power-actions', index:parseInt(powerBtn.dataset.powerIdx) } };
    dispatch('CONFIRM');
    return;
  }
});

// ══════════════════════════════════════════════════════════
// SCALE TO FIT (safe area 960×720)
// ══════════════════════════════════════════════════════════
function fit() {
  const vw = innerWidth, vh = innerHeight;
  const scale = Math.min(vw/960, vh/720);
  const c = document.getElementById('canvas');
  c.style.transform = `scale(${scale})`;
  c.style.left = ((vw - 1280*scale)/2) + 'px';
  c.style.top = ((vh - 720*scale)/2) + 'px';
}
addEventListener('resize', fit);

// ══════════════════════════════════════════════════════════
// BOOT
// ══════════════════════════════════════════════════════════
addEventListener('DOMContentLoaded', () => {
  fit();
  render();
  setTimeout(() => dispatch('BOOT_DONE'), 1400);
});
</script>
