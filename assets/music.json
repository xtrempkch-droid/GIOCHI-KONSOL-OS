{
  "schema_version": "1.6",
  "tab": "music",
  "regions": {
    "top_bar": { "height": 40 },
    "now_playing": {
      "height": 160,
      "album_art": { "type": "album_art", "size": { "width": 120, "height": 120 } },
      "text": ["title", "artist", "album"]
    },
    "progress": {
      "height": 20,
      "widgets": ["progress_bar", "time_elapsed", "time_total"]
    },
    "controls": {
      "height": 50,
      "type": "transport_controls",
      "buttons": { "prev": "Y", "play_pause": "A", "next": "X" }
    },
    "playlist": {
      "type": "track_list",
      "source": "/user/music",
      "scroll": "vertical",
      "show_artist": true
    },
    "hint_bar": { "height": 30 }
  },
  "socket": "/run/giochi/music.sock",
  "vram_budget_kb": 1024,
  "cpu_budget_pct": { "rk3326": 3, "rk3566": 2 }
}
