{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://giochi.local/schemas/layout.schema.json",
  "title": "Giochi Konsol OS v1.2 — layout.json (schema 1.6)",
  "type": "object",
  "required": ["schema_version", "tabs"],
  "properties": {
    "schema_version": { "const": "1.6" },
    "theme_id": { "type": "string" },
    "screen": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 240 },
        "orientation": { "enum": ["landscape", "portrait"] }
      },
      "additionalProperties": false
    },
    "tabs": {
      "type": "object",
      "required": ["order", "layouts"],
      "properties": {
        "order": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "default": { "type": "string" },
        "visual_center": { "type": "string" },
        "bar": { "type": "object" },
        "controls": { "type": "object" },
        "switch_transition": { "type": "string" },
        "layouts": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "persistent_regions": {
      "type": "array",
      "items": { "enum": ["topbar", "hint_bar"] }
    },
    "buttons": {
      "type": "object",
      "properties": {
        "back": { "type": "string" },
        "home": { "type": "string" },
        "home_short_press_ms": { "const": 500 },
        "settings": { "type": "string" },
        "exit_game_combo": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 2
        },
        "exit_game_combo_hold_ms": { "const": 500 }
      },
      "additionalProperties": false
    }
  }
}
