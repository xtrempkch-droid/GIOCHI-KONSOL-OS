{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://giochi.local/schemas/forge.schema.json",
  "title": "Giochi Konsol OS v1.2 — forge.json (requisitos do projeto)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "arch": { "enum": ["aarch64"] },
    "runtime": { "enum": ["godot", "retroarch", "proton"] },
    "graphics_api_min": { "enum": ["gles2", "gles3", "vulkan"] },
    "graphics_api_fallback": { "enum": ["gles2", "gles3"] },
    "godot_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "ram_min_mb": { "type": "integer", "minimum": 0 },
    "vram_min_mb": { "type": "integer", "minimum": 0 },
    "display_min_width": { "type": "integer", "minimum": 0 },
    "display_min_height": { "type": "integer", "minimum": 0 },
    "touchscreen_required": { "type": "boolean" }
  }
}
