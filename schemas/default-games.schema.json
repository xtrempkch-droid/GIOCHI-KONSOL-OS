{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://giochi.local/schemas/default-games.schema.json",
  "title": "Giochi Konsol OS — jogos padrao do sistema (assets/default-games.json)",
  "description": "Lista canonica dos jogos que vem no aparelho e servem de teste e benchmark. Nada entra em 'games' sem licenca explicita e sem bench.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "games"],
  "properties": {
    "schema_version": { "type": "string" },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "year", "project", "doc", "runtime",
                     "bench_scene", "bench_args", "license"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "year": { "type": "integer", "minimum": 1960 },
          "project": { "type": "string" },
          "doc": { "type": "string" },
          "runtime": { "enum": ["godot", "retroarch", "proton"] },
          "bench_scene": { "type": "string", "pattern": "^res://.*\\.tscn$" },
          "bench_args": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "evidence"],
            "properties": {
              "kind": {
                "description": "public_domain e freeware_permission entram na lista; clean_room tambem (codigo e arte proprios); copyleft fica de fora.",
                "enum": ["public_domain", "freeware_permission", "clean_room", "copyleft", "proprietary"]
              },
              "id": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "reason", "license"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "reason": { "type": "string", "minLength": 10 },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": {
                "enum": ["public_domain", "freeware_permission", "clean_room", "copyleft", "proprietary"]
              },
              "id": { "type": "string" }
            }
          },
          "upstream": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
