{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://giochi.local/schemas/settings.schema.json",
  "title": "Giochi Konsol OS v1.2 — /user/settings.json (schema 1.1)",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": "1.1" },
    "appearance": {
      "type": "object",
      "properties": {
        "theme_id": { "type": "string" },
        "accent_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "font_scale": { "type": "number", "minimum": 0.5, "maximum": 2.0 },
        "ui_scale": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
      },
      "additionalProperties": false
    },
    "system": {
      "type": "object",
      "properties": {
        "language": { "enum": ["pt-BR", "en-US"] },
        "timezone": { "type": "string" },
        "brightness": { "type": "integer", "minimum": 0, "maximum": 100 },
        "suspend_timeout_s": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "usb_mode": { "enum": ["mtp", "mass"] }
      },
      "additionalProperties": false
    },
    "sound": {
      "type": "object",
      "properties": {
        "master_volume": { "type": "integer", "minimum": 0, "maximum": 100 },
        "game_volume": { "type": "integer", "minimum": 0, "maximum": 100 },
        "music_volume": { "type": "integer", "minimum": 0, "maximum": 100 },
        "muted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "store": {
      "type": "object",
      "properties": {
        "region": { "type": "string", "minLength": 2, "maxLength": 3 },
        "source": { "enum": ["curated", "itchio"] }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "wifi_enabled": { "type": "boolean" },
        "wifi_last_ssid": { "type": ["string", "null"] },
        "wifi_credentials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ssid", "psk"],
            "properties": {
              "ssid": { "type": "string" },
              "psk": { "type": "string" }
            }
          }
        },
        "bluetooth_enabled": { "type": "boolean" },
        "bluetooth_paired": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
