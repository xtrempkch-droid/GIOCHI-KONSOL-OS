# Giochi Konsol OS v1.2 — base de defconfig RK3566 (Cortex-A55, Mali-G52).
#
# Template consumido por tools/gen-defconfigs.sh. NAO editar os arquivos
# gerados em buildroot/configs/: altere aqui e rode `make defconfigs`.
# O gerador substitui os marcadores inline (aparelho, SoC e a linha de
# ISSUE do login) e troca os blocos de DTS e de U-Boot. Um bloco so e
# trocado quando o marcador esta SOZINHO na linha; por isso este
# comentario nao cita marcador nenhum (senao o bloco sairia duplicado
# e o Buildroot avisaria "override: reassigning to symbol").

BR2_aarch64=y
BR2_cortex_a55=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# LTO desligado: experimental no Buildroot e quebra pacotes C++/musl.
BR2_TARGET_OPTIMIZATION="-O3 -pipe"
BR2_ENABLE_LTO=n

BR2_TARGET_GENERIC_HOSTNAME="giochi"
BR2_TARGET_GENERIC_ISSUE="Giochi Konsol OS v1.2 - RK3566 (generico)"
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/device_table.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/post-image.sh"
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_E2FSPROGS=y
# Ferramentas de HOST usadas por board/giochi/mkbootimg.sh. Sem declarar aqui,
# o build dependia do que estivesse instalado na maquina (o workflow de imagens
# faz 'apt install dosfstools mtools'): em outra maquina o post-image falhava
# no fim, depois de compilar tudo. O Buildroot poe $(HOST_DIR)/bin no PATH
# (BR_PATH) destes scripts.
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y
# boot.scr a partir de board/giochi/boot.cmd: o mkbootimg.sh EXIGE boot.scr
# para montar a particao A. Sem estas linhas ninguem o gerava.
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_BOOT_SCRIPT_SOURCE="$(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/boot.cmd"

# --- init: BusyBox (ADR-02), sem systemd -------------------------------
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/busybox.fragment"

# --- rootfs A/B: SquashFS ro, ZSTD (RK3566 tem crypto extensions) ------
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# Sem xattr: o Buildroot 2024.02 nao expoe essa opcao (xattrs sao
# sempre gravados). Antes havia BR2_TARGET_ROOTFS_SQUASHFS4_NO_XATTR,
# um simbolo INEXISTENTE que era descartado em silencio.

# --- kernel (S1) -------------------------------------------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12"
# arm64/ARM tem UM unico defconfig no kernel: arch/arm64/configs/defconfig.
# NAO use BR2_LINUX_KERNEL_USE_DEFCONFIG aqui: o Buildroot acrescenta
# "_defconfig" ao valor (linux.mk: LINUX_KCONFIG_DEFCONFIG = <valor>_defconfig),
# entao "defconfig" virava "defconfig_defconfig" e o build morria com
# "Can't find default configuration arch/arm64/configs/defconfig_defconfig".
# A opcao certa e a de configuracao padrao da arquitetura (help do Buildroot:
# "useful on architectures that have a single defconfig file, such as ARM64").
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/linux.fragment $(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/linux-zstd.fragment $(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/linux-powkiddy.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-anbernic-rg353v"
BR2_LINUX_KERNEL_IMAGE=y


# --- U-Boot (ADR-01) ---------------------------------------------------
# U-Boot mainline 2024.10 (defconfig quartz64-a-rk3566).
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="quartz64-a-rk3566"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_GIOCHI_PATH)/board/giochi/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_PYTHON3=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
# mkeficapsule (compilado em make tools) usa libuuid e gnutls. Sem estas duas
# linhas o build so passa porque a maquina tem uuid-dev/gnutls-dev instalados;
# o runner de CI tem, uma imagem limpa nao. Falhas reais, em sequencia:
#   uuid/uuid.h: No such file or directory
#   gnutls/gnutls.h: No such file or directory
BR2_TARGET_UBOOT_NEEDS_UTIL_LINUX=y
BR2_TARGET_UBOOT_NEEDS_GNUTLS=y
BR2_TARGET_UBOOT_NEEDS_ROCKCHIP_RKBIN=y
BR2_PACKAGE_ROCKCHIP_RKBIN=y
BR2_PACKAGE_ROCKCHIP_RKBIN_TPL_FILENAME="bin/rk35/rk3566_ddr_1056MHz_v1.18.bin"
BR2_PACKAGE_ROCKCHIP_RKBIN_BL31_FILENAME="bin/rk35/rk3568_bl31_v1.43.elf"

# --- pilha grafica (ADR-04/05/06) --------------------------------------
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_IMAGE=y

# --- audio (ADR-08) ----------------------------------------------------
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_FLAC=y
BR2_PACKAGE_LIBVORBIS=y

# --- utilitarios base --------------------------------------------------
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_LIBARCHIVE=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_UTIL_LINUX=y

# --- rede/BT (integrado na X55; dongle nas demais — ADR-14) ------------
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
# rfkill vem do util-linux desde o Buildroot 2022.02: o pacote
# standalone foi REMOVIDO e BR2_PACKAGE_RFKILL agora e um simbolo
# legacy que liga BR2_LEGACY (o build aborta em Makefile.legacy).
BR2_PACKAGE_UTIL_LINUX_RFKILL=y

# --- USB com o PC: MTP (userspace) + rede/SSH via USB -------------------
BR2_PACKAGE_GIOCHI_MTPD=y
BR2_PACKAGE_GIOCHI_MTPD_STORAGE="/user"
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_DROPBEAR_CLIENT=n
BR2_PACKAGE_IPROUTE2=y

# --- Giochi ------------------------------------------------------------
BR2_PACKAGE_GIOCHI_INIT=y
BR2_PACKAGE_GIOCHI_INIT_SOC="rk3566"
BR2_PACKAGE_GIOCHI_INIT_DEVICE="rk3566-generic"
BR2_PACKAGE_GIOCHI_MUSIC=y
BR2_PACKAGE_GIOCHI_MUSICD=y
BR2_PACKAGE_GIOCHI_LAUNCHER=y
BR2_PACKAGE_GIOCHI_ASSETS=y
BR2_PACKAGE_GIOCHI_TOOLS=y
BR2_PACKAGE_GIOCHI_PROTON=n
BR2_PACKAGE_GIOCHI_DONGLES=y
