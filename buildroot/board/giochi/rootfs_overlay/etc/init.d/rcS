#!/bin/sh
# Giochi Konsol OS v1.2 — rcS. Executa os scripts S* em ordem.
#
# ORDEM: S00bootlog roda PRIMEIRO e sozinho — ele monta a particao FAT do
# cartao e publica o caminho do log em /run/giochi/bootlog.path. O resto roda
# com stdout/stderr duplicados para esse arquivo (via tee), de forma que o que
# aparece na tela durante o boot tambem fica gravado e pode ser lido num PC
# depois (docs/BOOT-DEBUG.md).
set -u

run_scripts() {
    for script in /etc/init.d/S[0-9][0-9]*; do
        case "$script" in
            */rcS|*/rcK|*/S00bootlog) continue ;;
        esac
        [ -x "$script" ] || continue
        logger -t rcS -- "start $script" 2>/dev/null || true
        # Sem '2>/dev/null': o stderr dos servicos e exatamente o que se quer
        # no log quando algo falha no boot.
        "$script" start || "$script"
    done
}

if [ -x /etc/init.d/S00bootlog ]; then
    /etc/init.d/S00bootlog start || true
fi

bootlog=""
if [ -r /run/giochi/bootlog.path ]; then
    bootlog=$(sed -n '1p' /run/giochi/bootlog.path 2>/dev/null)
fi

if [ -n "$bootlog" ] && [ -w "$bootlog" ] && \
   [ "$bootlog" != "/dev/null" ] && command -v tee >/dev/null 2>&1; then
    run_scripts 2>&1 | tee -a "$bootlog"
else
    run_scripts
fi
