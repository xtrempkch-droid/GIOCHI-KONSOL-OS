#!/bin/sh
# Giochi Konsol OS v1.2 — rcS. Executa os scripts S* em ordem.
#
# ORDEM: S01relogio roda antes de tudo (o aparelho nao tem RTC e o kernel
# acorda em 2017; sem isso a primeira linha do log — justamente a que diz se o
# boot anterior terminou — sairia com data de nove anos atras). Depois
# S00bootlog, sozinho: ele monta a particao FAT do cartao e publica o caminho
# do log em /run/giochi/bootlog.path. O resto roda com stdout/stderr
# duplicados para esse arquivo (via tee), de forma que o que aparece na tela
# durante o boot tambem fica gravado e pode ser lido num PC depois
# (docs/BOOT-DEBUG.md).
set -u

run_scripts() {
    for script in /etc/init.d/S[0-9][0-9]*; do
        case "$script" in
            */rcS|*/rcK|*/S00bootlog|*/S01relogio) continue ;;
        esac
        [ -x "$script" ] || continue
        logger -t rcS -- "start $script" 2>/dev/null || true
        # Sem '2>/dev/null': o stderr dos servicos e exatamente o que se quer
        # no log quando algo falha no boot.
        #
        # NAO existe fallback para chamar o script sem argumento: isso rodava o
        # servico DUAS vezes e, como o primeiro rc != 0 vinha do proprio
        # servico, a segunda chamada so imprimia "Usage: ... {start|stop}"
        # (visto no boot real da X55, vindo do S10mdev). Falhou, fica no log.
        if ! "$script" start; then
            logger -t rcS -- "aviso: $script start retornou erro" 2>/dev/null \
                || true
            echo "rcS: $script start retornou erro" >&2
        fi
    done
}

# Relogio primeiro: sem RTC o kernel acorda em 2017 e tudo que for escrito
# antes disto carrega a data errada (ver scripts/init.d/S01relogio).
if [ -x /etc/init.d/S01relogio ]; then
    /etc/init.d/S01relogio start || true
fi

if [ -x /etc/init.d/S00bootlog ]; then
    /etc/init.d/S00bootlog start || true
fi

bootlog=""
if [ -r /run/giochi/bootlog.path ]; then
    bootlog=$(sed -n '1p' /run/giochi/bootlog.path 2>/dev/null)
fi

if [ -n "$bootlog" ] && [ -w "$bootlog" ] && \
   [ "$bootlog" != "/dev/null" ] && command -v tee >/dev/null 2>&1; then
    run_scripts 2>&1 | tee -a "$bootlog"
else
    run_scripts
fi
