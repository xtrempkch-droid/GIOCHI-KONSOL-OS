# Giochi Konsol OS v1.2 — /etc/inittab (ADR-02: BusyBox init, sem systemd).
# Ordem da secao S3: S05 -> S10 -> S30 -> S40dongle -> S50usb -> S55usbnet ->
# S60mtpd -> S62sshd -> S90graphics. O S90graphics faz `exec` do supervisor:
# e o ULTIMO de proposito (AGENTS.md 3.86).

::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -t sysfs sysfs /sys
::sysinit:/bin/mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
::sysinit:/bin/mount -t devtmpfs devtmpfs /dev
# /var precisa ser GRAVAVEL: a raiz e' SquashFS somente leitura. Sem este
# tmpfs, "mkdir -p /var/log" falhava calado (o diretorio nao existe na imagem)
# e o seedrng registrava
#   seedrng: can't create directory '/var/lib/seedrng': Read-only file system
# — o pool de entropia nao era salvo entre boots e o "crng init done" so
# aparecia aos 11 s de uptime (medido no serial da X55). AGENTS.md §3.60.
::sysinit:/bin/mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /var
::sysinit:/bin/mkdir -p /var/log /var/lib/seedrng /var/run /var/tmp /dev/pts /dev/shm /run/giochi
::sysinit:/bin/mount -t devpts devpts /dev/pts
::sysinit:/bin/mount -t tmpfs -o nosuid,nodev tmpfs /dev/shm
# Cresce a particao de dados (GIOCHI) para ocupar o cartao inteiro. TEM de
# rodar ANTES do `mount -a`: com /user montada o kernel nao consegue reler a
# tabela de particoes (BLKRRPART falha com o dispositivo em uso). A imagem
# distribuida tem 512 MiB de /user e cabe em qualquer cartao; os 28 GB
# restantes de um cartao de 32 GB ficavam sem uso (etc/giochi/grow-user.sh).
::sysinit:/etc/giochi/grow-user.sh
::sysinit:/bin/mount -a
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# Sem getty: o console e consumido pelo Launcher (secao 4.1).
tty1::respawn:/usr/bin/giochi-init
::ctrlaltdel:/sbin/reboot
::shutdown:/etc/init.d/rcK
::restart:/sbin/init
