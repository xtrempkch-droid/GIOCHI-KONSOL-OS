# Giochi Konsol OS v1.2 — BusyBox (ADR-02).
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_MDEV=y
CONFIG_UDHCPC=y
CONFIG_FEATURE_UDHCPC_SCRIPT=y
CONFIG_WPA_SUPPLICANT=n
CONFIG_IWCONFIG=n
CONFIG_POWERTOP=y
CONFIG_REBOOT=y
CONFIG_SWAPONOFF=y
CONFIG_MKSWAP=y
CONFIG_FEATURE_SWAPON_PRI=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_LOGGER=y
CONFIG_FEATURE_SYSLOGD_CFG=y
CONFIG_FIND=y
CONFIG_OD=y
CONFIG_DF=y
CONFIG_FREE=y
CONFIG_TR=y
CONFIG_AWK=y
CONFIG_XXD=y
# --- rede USB / SSH (secao 4.6) ---------------------------------------
CONFIG_UDHCPD=y
CONFIG_FEATURE_UDHCPD_WRITE_LEASES_EARLY=y
CONFIG_DHCPD_LEASES_FILE="/run/giochi/udhcpd.leases"
CONFIG_PIDOF=y
CONFIG_CHPASSWD=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_MOUNTPOINT=y
CONFIG_DROPBEAR=n
