# Giochi Konsol OS v1.2 — BusyBox (ADR-02).
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y
CONFIG_MDEV=y
CONFIG_UDHCPC=y
# CONFIG_WPA_SUPPLICANT, CONFIG_IWCONFIG: NAO EXISTEM no BusyBox. O
# wpa_supplicant e o iw vem dos pacotes do Buildroot
# (BR2_PACKAGE_WPA_SUPPLICANT, BR2_PACKAGE_IW), nao de applet do BusyBox —
# pedi-los aqui era descartado em silencio.
# CONFIG_FEATURE_UDHCPC_SCRIPT tambem nao existe: o udhcpc aceita -s em
# qualquer configuracao.
CONFIG_POWERTOP=y
CONFIG_REBOOT=y
# O applet e' dois: SWAPON e SWAPOFF. `CONFIG_SWAPONOFF` nao existe e era
# descartado calado (o swap do S30swap dependia dele).
CONFIG_SWAPON=y
CONFIG_SWAPOFF=y
CONFIG_MKSWAP=y
CONFIG_FEATURE_SWAPON_PRI=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_ASH=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_LOGGER=y
CONFIG_FEATURE_SYSLOGD_CFG=y
# --- log de boot no cartao SD (S00bootlog, docs/BOOT-DEBUG.md) ---------
# syslogd -O grava com write() direto no arquivo (sobrevive a desligamento
# bruto); klogd repassa o kernel; tee duplica rcS. Os tres sao default no
# Buildroot, mas ficam explicitos porque sem eles o log some em silencio.
CONFIG_SYSLOGD=y
CONFIG_KLOGD=y
CONFIG_TEE=y
# --- LABEL= no fstab (PARTICAO C /user) --------------------------------
# Sem FEATURE_MOUNT_LABEL o busybox trata "LABEL=GIOCHI_USER" como NOME DE
# ARQUIVO: o mount -a falha calado e /user nunca e montada (settings.json,
# /user/music, symlink de chaves do dropbear: tudo em cima de SquashFS
# somente-leitura). Medido no .config do busybox 1.36.1 da imagem.
CONFIG_FEATURE_MOUNT_LABEL=y
CONFIG_FIND=y
CONFIG_OD=y
CONFIG_DF=y
CONFIG_FREE=y
CONFIG_TR=y
CONFIG_AWK=y
CONFIG_XXD=y
# --- rede USB / SSH (adendo 4.6.1) ------------------------------------
# Sem DHCP no console: o PC usa 10.55.0.1/24 estatico e o console 10.55.0.2.
CONFIG_PIDOF=y
CONFIG_CHPASSWD=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_MOUNTPOINT=y
# CONFIG_DROPBEAR NAO e' applet do BusyBox (e' pacote: BR2_PACKAGE_DROPBEAR).
# --- nc -U: o cliente do control.sock (docs/APP-SDK.md / giochi-ctl) ----
# O console nao tem Python, e o unico jeito de um script do PC falar com
# /run/giochi/control.sock (via `ssh ... "printf ... | nc -U ..."`) e' o nc
# do BusyBox com soquetes Unix. O default do 1.36.1 e' DESLIGADO e nada no
# fragmento pedia: o `tools/giochi-ctl.py` documentava a dependencia e o
# binario nao existia na imagem. Medido no aparelho:
#
#   $ ssh root@10.55.0.2 'printf "PING\n" | nc -U /run/giochi/control.sock'
#   sh: nc: not found
#
# ATENCAO: NAO existe CONFIG_NC_UNIX no BusyBox 1.36.1 (conferido em
# networking/nc.c: zero ocorrencias de AF_UNIX). O nc do BusyBox so' fala
# TCP/UDP — nao ha -U. Quem conversa com o control.sock e' o binario
# giochi-ctl do proprio console (src/tools), pelo mesmo giochi_sock_*.
CONFIG_NC=y

# PortMaster usa unzip E zip em runtime. O BusyBox 1.36.1 TEM o applet unzip
# (CONFIG_UNZIP, ja' ligado por default no build real) mas NAO tem zip: o
# applet foi removido do BusyBox ha' muitas versoes (archival/Config.in do
# 1.36.1: `config UNZIP` existe, `config ZIP` nao). O zip de verdade vem do
# pacote Info-ZIP (BR2_PACKAGE_ZIP), pedido pelo giochi-portmaster no
# Config.in — nao tente um CONFIG_ZIP aqui: o validador do fragmento
# (suíte log-de-boot) reprova simbolo inexistente.
