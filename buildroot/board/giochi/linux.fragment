# Giochi Konsol OS v1.2 — fragmento de kernel (S1, secoes 1.2 / 1.4 / 4.6)
#
# Merge:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig \
#       board/giochi/linux.fragment && make olddefconfig
#
# RK3326 (A35, 1-2 GB): ZRAM/SquashFS em LZ4.
# RK3566 (A55 + crypto): ZRAM/SquashFS em ZSTD (arquivo linux-zstd.fragment).

# --- base obrigatoria (secao 1.2) --------------------------------------
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_SWAP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK=y

# --- entrada (secao 4.1) ----------------------------------------------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# --- armazenamento (secao 1.3) ----------------------------------------
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VFAT_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# --- USB host (dongles, controles) ------------------------------------
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_ACM=y

# --- USB gadget: MTP + Mass Storage (secao 4.6) -----------------------
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_MTP=y
CONFIG_USB_CONFIGFS_F_MASS_STORAGE=y
CONFIG_USB_F_MTP=y
CONFIG_USB_F_MASS_STORAGE=y

# --- graficos (ADR-04/05/06) ------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_DRM_PANFROST=y
# RK3326 usa Mali-G31 (Panfrost). Lima so e util para GPUs Utgard.
CONFIG_DRM_LIMA=y
CONFIG_FB=n
CONFIG_FB_EFI=n
CONFIG_LOGO=n
# ---------------------------------------------------------------------------
# Bootsplash do kernel (PRE-PRONTO — desativado)
#
# O caminho suportado na v1.2 e U-Boot (splash.bmp) + Launcher
# (bootlogo.rgba); nada disso exige patch de kernel. O logo do kernel exige
# CONFIG_LOGO_CUSTOM com uma imagem de 80x80 compilada em
# drivers/video/logo/logo_custom_clut224.ppm, que NAO e mainline-friendly
# (patch local no tree do kernel). Se um dia for necessario:
#
# CONFIG_LOGO=y
# CONFIG_LOGO_LINUX_MONO=n
# CONFIG_LOGO_LINUX_VGA16=n
# CONFIG_LOGO_LINUX_CLUT224=n
# CONFIG_LOGO_CUSTOM_CLUT224=y
# CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# CONFIG_FB_SIMPLE=y
#
# Decisao registrada: manter 'n' na v1.2 para nao pagar 2 s de boot nem
# carregar a pilha de fbcon (o Launcher desenha o splash poucos ms apos o
# DRM subir).
# ---------------------------------------------------------------------------

# --- audio ALSA (ADR-08) ----------------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SIMPLE_CARD=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_PCM_TIMER=y

# --- firmware loader para dongles (secao 1.4) -------------------------
CONFIG_FW_LOADER=y

# --- Wi-Fi/Bluetooth: dependencias + modulos (.ko, fora do boot) -------
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_R8188EU=m
CONFIG_RTL8192CU=m
CONFIG_RTL8XXXU=m
CONFIG_MT7601U=m
CONFIG_ATH9K_HTC=m
CONFIG_ATH9K_HTC_DEBUGFS=n
# '8812au' e out-of-tree (aircrack-ng/rtl8812au); empacotado como modulo
# externo no post-build (ver board/giochi/post-build.sh).

# --- removidos (secao 1.2) --------------------------------------------
CONFIG_DRM_NOUVEAU=n
CONFIG_DRM_AMDGPU=n
CONFIG_DRM_I915=n
CONFIG_BLK_DEV_SR=n
CONFIG_ISO9660_FS=n
CONFIG_UDF_FS=n
CONFIG_CHR_DEV_SG=n
CONFIG_WLAN_VENDOR_BROADCOM=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_ETHTOOL_NETLINK=n
CONFIG_XFRM_USER=n
CONFIG_NET_KEY=n
CONFIG_DUMMY=n
CONFIG_MACVLAN=n
CONFIG_VXLAN=n
# PCI/PCIe genericos: no RK3326 nao ha PCIe usado pela pilha do console.
CONFIG_PCI=n
CONFIG_PCI_MSI=n

# --- sem systemd/desktop ----------------------------------------------
CONFIG_CGROUPS=n
CONFIG_NAMESPACES=n
CONFIG_AUDIT=n
CONFIG_SECURITY_SELINUX=n
CONFIG_FB_VESA=n
CONFIG_BACKLIGHT_CLASS_DEVICE=y
