config BR2_PACKAGE_GIOCHI_TOOLS
	bool "giochi-tools (verify, extract, thumbgen, pack)"
	default y
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBARCHIVE
	select BR2_PACKAGE_LIBPNG
	help
	  Utilitarios de instalacao e update: giochi-verify (S12),
	  giochi-extract e giochi-thumbgen (S9), giochi-pack.sh.
