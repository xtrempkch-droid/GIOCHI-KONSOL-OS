#!/bin/sh
# Giochi Konsol OS v1.2 — ciclo de vida do umtprd (MTP).
#
# Uso: giochi-mtpd start|stop|status|restart
#
# Pre-condicoes para 'start':
#   - gadget configfs criado e anexado ao UDC (giochi-usb-mode)
#   - FunctionFS montado em /dev/ffs-mtp (feito por giochi-usb-mode)
#
# O daemon NAO e supervisionado pelo giochi-init de proposito: ele depende do
# gadget, que muda de modo em runtime (MTP <-> Mass Storage). Se ele morrer,
# 'giochi-usb-mode mtp' o relanca.
set -u

CONF=${MTPD_CONF:-/etc/umtprd.conf}
PIDFILE=${MTPD_PIDFILE:-/run/giochi/umtprd.pid}
FFS_DIR=${FFS_DIR:-/dev/ffs-mtp}
BIN=${MTPD_BIN:-/usr/sbin/umtprd}
LOG=${MTPD_LOG:-/run/giochi/umtprd.log}

# Log no syslog E no stderr: o rcS roda os scripts com `2>&1 | tee -a $bootlog`,
# entao o stderr chega ao serial e ao cartao. Quando o /user esta' fora (modo
# `mass`) o cartao fica no PC e o SERIAL e' o unico instrumento que sobra.
log() {
    logger -t giochi-mtpd -- "$*" 2>/dev/null || true
    echo "giochi-mtpd: $*" >&2
}

running_pid() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
    [ -n "${pid:-}" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    echo "$pid"
}

do_start() {
    if pid=$(running_pid); then
        log "ja em execucao (pid $pid)"
        return 0
    fi

    [ -x "$BIN" ] || { log "binario ausente: $BIN"; return 1; }
    # O ep0 do FunctionFS e' um ARQUIVO REGULAR, nao um char device:
    #
    #   drivers/usb/gadget/function/f_fs.c : ffs_fs_init_fs_context()
    #       ctx->perms.mode = S_IFREG | 0600;
    #
    # (os endpoints do functionfs sao arquivos cujas file_operations fazem o
    # trabalho; quem cria /dev/<nome> e' o gadgetfs, outro subsistema). A
    # versao anterior exigia `[ -c ... ]` e portanto NUNCA passava — o mount
    # estava certo e o guarda recusava, com a mensagem "FunctionFS nao
    # montado", que mandava investigar o mount. Medido na X55: nenhuma linha
    # de erro de mount e mesmo assim esta mensagem, em todo boot.
    [ -e "$FFS_DIR/ep0" ] || {
        log "FunctionFS nao montado em $FFS_DIR (gadget fora do modo MTP?)"
        return 1
    }

    mkdir -p "$(dirname "$PIDFILE")" 2>/dev/null || true
    # A opcao de configuracao do uMTP-Responder e' `-conf <arquivo>`, NAO
    # `-c` (`src/umtprd.c`: PARAMETER_CONF "-conf"). Com `-c` ele imprime
    # "Unknown command line option: -c" e sai com 1 — e como a saida ia
    # toda para $LOG, o boot registrava apenas "umtprd nao iniciou", sem
    # causa. Dois boots perdidos por causa de uma letra.
    "$BIN" -conf "$CONF" >>"$LOG" 2>&1 &
    pid=$!
    echo "$pid" > "$PIDFILE"

    # Espera o ep0 abrir de fato (o responder falha rapido se nao abrir).
    i=0
    while [ "$i" -lt 20 ]; do
        kill -0 "$pid" 2>/dev/null || {
            log "umtprd terminou ao iniciar (ver $LOG)"
            # As ultimas linhas do log do daemon sao a unica pista quando ele
            # morre antes de abrir o ep0. Mostrar aqui evita "o MTP nao sobe"
            # sem motivo no serial.
            [ -r "$LOG" ] && tail -n 3 "$LOG" 2>/dev/null | while IFS= read -r _l; do
                log "  umtprd: $_l"
            done
            rm -f "$PIDFILE"
            return 1
        }
        [ "$i" -ge 3 ] && break
        sleep 0.1
        i=$((i + 1))
    done
    log "iniciado (pid $pid, storage em $CONF)"
    return 0
}

do_stop() {
    pid=$(running_pid) || { rm -f "$PIDFILE"; return 0; }

    kill "$pid" 2>/dev/null
    i=0
    while [ "$i" -lt 30 ]; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.1
        i=$((i + 1))
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    rm -f "$PIDFILE"
    log "parado (pid $pid)"
    return 0
}

case "${1:-status}" in
    start)   do_start ;;
    stop)    do_stop ;;
    restart) do_stop; do_start ;;
    status)
        if pid=$(running_pid); then
            echo "running $pid"
        else
            echo "stopped"
            exit 1
        fi
        ;;
    *)
        echo "uso: $0 start|stop|restart|status" >&2
        exit 2
        ;;
esac
