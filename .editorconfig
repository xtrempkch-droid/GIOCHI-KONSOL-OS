root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,h}]
indent_size = 4

[*.{cpp,hpp}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 88

[*.{sh,conf,fragment,cmd}]
indent_size = 4

[S[0-9][0-9]*]
indent_size = 4

[Makefile]
indent_style = tab

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
